@model HandyFix.Web.ViewModels.Services.ServiceDetailsViewModel
@using System.Globalization
@inject HandyFix.Web.Services.IBusinessRecord Business
@using HandyFix.Web.ViewModels.Services
@* Anything written inside a script block below goes through Json.Serialize. Razor's own HTML
   encoding is wrong there: a script block is never HTML-decoded, so "&" reached search engines
   as "&amp;" and "£" as "&#xA3;" (PROJECT_STATE Section 3bv). *@
@{
    this.Layout = "_Layout";

    var isPlumbing = Model.CategoryName == "Plumbing";
    var isBuilding = Model.CategorySlug == CategorySlugs.SmallBuildingWorks;
    var isQuoteOnly = isBuilding || Model.IsQuoteOnly;

    // An emergency is taken by phone and WhatsApp at any hour, never booked as a 9 to 5 slot
    // (PROJECT_STATE Section 3eg): the page offers the call and WhatsApp in place of the booking.
    var isEmergency = Model.IsEmergency && !isQuoteOnly;
    var durationHours = isQuoteOnly ? "Day Rate / Survey" : Durations.HoursOrMinutes(Model.EstimatedDurationMinutes);

    // The phone's floating "Book Now" opens the booking with this service already chosen
    // (_MobileStickyCta). A quote-only service cannot be booked, so its button stays the plain one;
    // on the emergency page it calls the business instead.
    if (isEmergency)
    {
        this.ViewData["MobileCtaCalls"] = true;
    }
    else if (!isQuoteOnly)
    {
        this.ViewData["BookNowUrl"] = this.Url.Action("Index", "Booking", new { selectedServiceId = Model.Id, categorySlug = Model.CategorySlug });
    }

    // Dynamic Image path
    var serviceImage = Model.ImageUrl;

    // Gas work shows its Gas Safe registration in the hero and the sidebar.
    var isGasSafe = Model.IsGasSafeWork;

    // The line under the description: the price and how to get the work done, from the price in
    // the admin. The two fixed boxes and the "mobile crews" sentence that stood here were the
    // same on every page of a division (Section 3ep).
    var priceLine = isQuoteOnly
        ? "Priced after a free survey at your home: you get a fixed quote before any work starts, and there is no obligation to go ahead."
        : isEmergency
            ? $"£{Model.BasePrice:F0} an hour at any time of day or night, with a one-hour minimum and no separate call-out fee; parts are extra. Call us or message us on WhatsApp."
            : $"We charge £{Model.BasePrice:F0} an hour for this work, with a one-hour minimum; after the first hour, time is billed in 30-minute blocks. Pick a time that suits you online: a £{Deposit.Pounds} deposit secures your slot and comes off the final bill.";

    // The page's own blocks; an empty one is left off.
    var findings = PagePoints.Of(Model.CommonFindings, PagePoints.FindingIcon);
    var steps = PagePoints.LinesOf(Model.VisitSteps);
    var before = PagePoints.Of(Model.BeforeWeArrive, PagePoints.BeforeIcon);
    var included = PagePoints.LinesOf(Model.Included);
    var notIncluded = PagePoints.LinesOf(Model.NotIncluded);
    var faqs = Model.Faqs?.ToList() ?? new List<ServiceFaqViewModel>();
    var faqJsonEntries = faqs.Count > 0
        ? string.Join(",", faqs.Select(f =>
            $"{{ \"@type\": \"Question\", \"name\": {System.Text.Json.JsonSerializer.Serialize(f.Question)}, \"acceptedAnswer\": {{ \"@type\": \"Answer\", \"text\": {System.Text.Json.JsonSerializer.Serialize(f.Answer)} }} }}"))
        : null;

    // Local Expert: the business's real co-founder on every service page. Only the role
    // adapts per category - the bio is his own supplied wording, not written per trade.
    var expertName = "Zapryan";
    var expertRole = isBuilding ? "Projects Director" : (isPlumbing ? "Owner & Lead Plumber" : "Owner & Lead Handyman");
    var expertBorough = "Surrey";
    var expertBio = "I've been in the construction industry since 2004, and I believe the secret to stress-free renovations is simple: turn up on time, manage the trades properly, and do the job right the first time. I personally survey every project and work alongside our teams on-site until the final checklist is complete.";
    var expertClosingLine = "You'll always have a direct line to me, and my personal guarantee that the work is finished to perfection.";
    var expertAvatar = "/images/expert-zap.webp";
}

<div class="page-container services-page">
    <!-- Hero Section -->
    <section class="service-hero-section">
        <div class="service-hero-image" id="service-hero-bg" style="background-image: url('@serviceImage')" data-bg-src="@serviceImage" data-bg-fallback="/images/hero.webp"></div>
        <div class="service-hero-overlay"></div>
        <div class="service-hero-content">
            <nav class="service-hero-breadcrumbs" aria-label="breadcrumb">
                <a asp-controller="Services" asp-action="Index">Services</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <a asp-route="ServiceCategory" asp-route-categorySlug="@Model.CategorySlug">@Model.CategoryName</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-white">@Model.Name</span>
            </nav>
            <h1 class="service-hero-title">@Model.Name Specialists</h1>
            <div class="service-hero-badges">
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">verified</span> Professional Service
                </span>
                @* "24/7" only on the emergency page, which is the one service taken at any hour.
                   Every other plumbing service is booked online, Monday to Saturday, 9 to 5, so
                   its page says that instead. Gas work shows its Gas Safe registration in that
                   place; handyman and building pages show the one badge. *@
                @if (isGasSafe)
                {
                    <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                        <img class="gas-safe-logo-pill" src="@GasSafeLogo.Url" asp-append-version="true" alt=""> Gas Safe Registered
                    </span>
                }
                else if (isEmergency)
                {
                    <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                        <span class="material-symbols-outlined">call</span> 24/7 by Phone &amp; WhatsApp
                    </span>
                }
                else if (isPlumbing)
                {
                    <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                        <span class="material-symbols-outlined">calendar_month</span> Pick a Time That Suits You
                    </span>
                }
            </div>
        </div>
    </section>

    <!-- Main Layout Container -->
    <div class="service-details-layout">
        <!-- Main Content Area -->
        <main>
            <!-- Quick Specs Bento -->
            <div class="specs-bento-grid">
                <div class="spec-bento-card">
                    @if (isEmergency)
                    {
                        <span class="material-symbols-outlined spec-bento-icon">schedule</span>
                        <span class="spec-bento-label">We Aim to Arrive In</span>
                        <span class="spec-bento-value">60 to 90 Minutes</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined spec-bento-icon">history</span>
                        <span class="spec-bento-label">Typical Duration</span>
                        <span class="spec-bento-value">@durationHours</span>
                    }
                </div>
                <div class="spec-bento-card">
                    <span class="material-symbols-outlined spec-bento-icon">category</span>
                    <span class="spec-bento-label">Service Category</span>
                    <span class="spec-bento-value">@Model.CategoryName</span>
                </div>
                <div class="spec-bento-card col-span-2">
                    @if (isQuoteOnly)
                    {
                        <span class="material-symbols-outlined spec-bento-icon">request_quote</span>
                        <span class="spec-bento-label">Pricing Model</span>
                        <span class="spec-bento-value">Free Survey &amp; Fixed Quote</span>
                    }
                    else if (isEmergency)
                    {
                        <span class="material-symbols-outlined spec-bento-icon">payments</span>
                        <span class="spec-bento-label">Emergency Rate</span>
                        <span class="spec-bento-value">£@Model.BasePrice.ToString("F0") per Hour</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined spec-bento-icon">payments</span>
                        <span class="spec-bento-label">Starting Price</span>
                        <span class="spec-bento-value">From £@Model.BasePrice.ToString("F0")</span>
                    }
                </div>
            </div>

            <!-- The opening: the description, then the price and how to book (Section 3ep) -->
            <section class="details-prose">
                <h2 class="details-section-title">Service Overview</h2>
                @foreach (var paragraph in Paragraphs.Of(Model.Description))
                {
                    <p>@paragraph</p>
                }
                <p>@priceLine</p>
            </section>

            @if (findings.Count > 0)
            {
                <section class="details-prose service-block">
                    <h2 class="details-section-title">What we usually find</h2>
                    <ul class="service-points">
                        @foreach (var point in findings)
                        {
                            <li>
                                <span class="material-symbols-outlined" aria-hidden="true">@point.Icon</span>
                                <div><strong>@point.Lead</strong> @point.Rest</div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (steps.Count > 0)
            {
                <section class="details-prose service-block">
                    <h2 class="details-section-title">The visit, step by step</h2>
                    <ol class="service-steps">
                        @foreach (var step in steps)
                        {
                            <li><div>@step</div></li>
                        }
                    </ol>
                </section>
            }

            @if (before.Count > 0)
            {
                <section class="details-prose service-block">
                    <h2 class="details-section-title">Before we arrive</h2>
                    <ul class="service-points">
                        @foreach (var point in before)
                        {
                            <li>
                                <span class="material-symbols-outlined" aria-hidden="true">@point.Icon</span>
                                <div>@point.Lead @point.Rest</div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (included.Count > 0 || notIncluded.Count > 0)
            {
                <section class="service-block service-scope">
                    @if (included.Count > 0)
                    {
                        <div class="service-scope-box service-scope-yes">
                            <h3><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>What is included</h3>
                            <ul>
                                @foreach (var line in included)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (notIncluded.Count > 0)
                    {
                        <div class="service-scope-box service-scope-no">
                            <h3><span class="material-symbols-outlined" aria-hidden="true">cancel</span>What is not</h3>
                            <ul>
                                @foreach (var line in notIncluded)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </div>
                    }
                </section>
            }

            <!-- Questions about this job only; the general ones are on the FAQ page -->
            <section class="faq-accordion-group service-block">
                @if (faqs.Count > 0)
                {
                    <h2 class="details-section-title">Questions about @Model.Name.ToLower()</h2>
                    @for (var i = 0; i < faqs.Count; i++)
                    {
                        <details class="faq-accordion" open="@(i == 0)">
                            <summary class="faq-accordion-summary">
                                <span class="faq-accordion-title">@faqs[i].Question</span>
                                <span class="material-symbols-outlined faq-accordion-icon">expand_more</span>
                            </summary>
                            <div class="faq-accordion-content">@faqs[i].Answer</div>
                        </details>
                    }
                }
                <p class="service-faq-link">Deposits, cancelling and paying are on our <a asp-area="" asp-controller="Home" asp-action="FAQ">FAQ page</a>.</p>
            </section>

            @if (Model.SameVisitServices != null && Model.SameVisitServices.Any())
            {
                <section class="details-prose service-block">
                    <h2 class="details-section-title">Worth doing in the same visit</h2>
                    <div class="service-same-visit">
                        @foreach (var other in Model.SameVisitServices)
                        {
                            var otherPrice = other.CategorySlug == CategorySlugs.SmallBuildingWorks || other.IsQuoteOnly
                                ? "free quote"
                                : other.IsEmergency ? $"£{other.BasePrice:F0} an hour" : $"from £{other.BasePrice:F0}";
                            <a asp-route="ServiceDetails" asp-route-categorySlug="@other.CategorySlug" asp-route-serviceSlug="@other.Slug">
                                @other.Name <span class="service-same-visit-price">@otherPrice</span>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.Towns != null && Model.Towns.Any())
            {
                <section class="details-prose service-block">
                    <h2 class="details-section-title">Areas we cover</h2>
                    <div class="service-towns">
                        @foreach (var town in Model.Towns)
                        {
                            <a asp-route="AreaDetails" asp-route-areaSlug="@town.Slug">@town.Name</a>
                        }
                    </div>
                </section>
            }

            <!-- Local Expert Block -->
            <section class="local-expert-block">
                <div class="local-expert-avatar-wrapper">
                    <img class="local-expert-avatar" alt="@expertName - @expertRole" src="@expertAvatar" onerror="this.onerror=null;this.src='/images/hero.webp';" width="96" height="96" loading="lazy">
                </div>
                <div>
                    <span class="local-expert-meta">Your Local Expert</span>
                    <h3 class="local-expert-name">Hi, I'm @expertName – @expertRole in @expertBorough</h3>
                    <p class="local-expert-bio">@expertBio @expertClosingLine</p>
                </div>
            </section>
        </main>

        <!-- Sidebar Area -->
        <aside>
            <div class="sidebar-sticky-wrapper">
                <!-- CTA Booking Card -->
                <div class="sidebar-booking-card">
                @if (isQuoteOnly)
                {
                    <h3 class="sidebar-booking-title">Request a Project Quote</h3>
                    <p class="sidebar-booking-desc">Discuss your project with our @(isBuilding ? "multi-trade building and refurbishment" : "local plumbing and handyman") team across Surrey and South London.</p>
                    
                    <div class="sidebar-booking-features">
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Free site survey &amp; consultation</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Written, transparent quote in advance</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>@(isGasSafe ? "Gas Safe registered engineer" : (isBuilding ? "Fully insured multi-trade team" : "Local, insured technicians"))</span>
                        </div>
                    </div>

                    <div class="sidebar-booking-actions">
                        <a asp-controller="Home" asp-action="Contact" asp-route-service="@Model.Name" class="sidebar-booking-btn">
                            <span>Request Free Estimate</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="tel:@GlobalConstants.BusinessPhoneInternational" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <span class="material-symbols-outlined">call</span>
                            <span>Call Us: @GlobalConstants.BusinessPhone</span>
                        </a>
                        <a href="@GlobalConstants.BusinessWhatsAppUrl" target="_blank" rel="noopener" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <partial name="_WhatsAppIcon" />
                            <span>Message us on WhatsApp</span>
                        </a>
                    </div>
                    <p class="sidebar-booking-note">No obligation &bull; Free initial survey</p>
                }
                else if (isEmergency)
                {
                    <h3 class="sidebar-booking-title">Plumbing Emergency? Call Us Now</h3>
                    <p class="sidebar-booking-desc">We answer the phone 24 hours a day, 7 days a week, evenings and Sundays included.</p>

                    <div class="sidebar-booking-features">
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Phone answered 24/7</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>We aim to be with you in 60 to 90 minutes</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>£@Model.BasePrice.ToString("F0") per hour, one-hour minimum</span>
                        </div>
                    </div>

                    <div class="sidebar-booking-actions">
                        <a href="tel:@GlobalConstants.BusinessPhoneInternational" class="sidebar-booking-btn sidebar-booking-btn-book">
                            <span class="material-symbols-outlined">call</span>
                            <span>Call @GlobalConstants.BusinessPhone</span>
                        </a>
                        <a href="@GlobalConstants.BusinessWhatsAppUrl" target="_blank" rel="noopener" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <partial name="_WhatsAppIcon" />
                            <span>Message us on WhatsApp</span>
                        </a>
                    </div>
                    <p class="sidebar-booking-note">Not an emergency? <a asp-controller="Booking" asp-action="Index" asp-route-categorySlug="@Model.CategorySlug">Pick a time that suits you online</a>, Monday to Saturday, 9am to 5pm.</p>
                }
                else
                {
                    <h3 class="sidebar-booking-title">Book This Service Now</h3>
                    <p class="sidebar-booking-desc">Local technicians covering Surrey and South London. Fast, clean, and guaranteed.</p>
                    
                    <div class="sidebar-booking-features">
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Transparent fixed pricing</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Local, insured technicians</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Same-day service possible</span>
                        </div>
                    </div>

                    <div class="sidebar-booking-actions">
                        <a asp-controller="Booking" asp-action="Index" asp-route-selectedServiceId="@Model.Id" asp-route-categorySlug="@Model.CategorySlug" class="sidebar-booking-btn sidebar-booking-btn-book">
                            <span class="material-symbols-outlined">calendar_month</span>
                            <span>Book a Slot</span>
                        </a>
                        <a asp-controller="Home" asp-action="Contact" asp-route-service="@Model.Name" class="sidebar-booking-btn sidebar-booking-btn-outline">
                            <span>Request Your Booking</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a href="tel:@GlobalConstants.BusinessPhoneInternational" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <span class="material-symbols-outlined">call</span>
                            <span>Call Us: @GlobalConstants.BusinessPhone</span>
                        </a>
                        <a href="@GlobalConstants.BusinessWhatsAppUrl" target="_blank" rel="noopener" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <partial name="_WhatsAppIcon" />
                            <span>Message us on WhatsApp</span>
                        </a>
                    </div>
                    <p class="sidebar-booking-note">Requests are free &bull; Slots secured with a £@Deposit.Pounds deposit</p>
                }
                </div>

                <!-- Trust Card -->
                <div class="sidebar-trust-box">
                    <h4 class="sidebar-trust-title">Why Choose Us?</h4>
                    <div class="sidebar-trust-list">
                        <div class="sidebar-trust-item">
                            <span class="material-symbols-outlined sidebar-trust-icon">workspace_premium</span>
                            <div>
                                <p class="sidebar-trust-item-title">Fully Insured</p>
                                <p class="sidebar-trust-item-desc">Comprehensive public liability insurance.</p>
                            </div>
                        </div>
                        <div class="sidebar-trust-item">
                            <span class="material-symbols-outlined sidebar-trust-icon">health_and_safety</span>
                            <div>
                                <p class="sidebar-trust-item-title">Clean &amp; Tidy</p>
                                <p class="sidebar-trust-item-desc">We always wear shoe covers and clean up.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    @if (Model.RelatedServices != null && Model.RelatedServices.Any())
    {
        <!-- You Might Also Need -->
        <section class="pricing-typical-jobs-section">
            <h2 class="font-headline-lg text-primary text-center pricing-section-title">You Might Also Need</h2>
            <p class="font-body-md text-on-surface-variant text-center pricing-section-subtitle">
                Other @Model.CategoryName.ToLower() services our customers often book alongside this one.
            </p>

            <div class="pricing-cards-grid">
                @foreach (var related in Model.RelatedServices)
                {
                    <partial name="_PricingCard" model="@(new PricingCardViewModel
                                                         {
                                                             Name = related.Name,
                                                             IconName = CategoryIcons.ForSlug(related.CategorySlug),
                                                             ImageUrl = related.ImageUrl,
                                                             MediumCopyUrl = related.MediumCopyUrl,
                                                             Description = related.Description,
                                                             BasePrice = related.BasePrice,
                                                             EstimatedDurationMinutes = related.EstimatedDurationMinutes,
                                                             IsQuoteBased = related.CategorySlug == CategorySlugs.SmallBuildingWorks || related.IsQuoteOnly,
                                                             DivisionClass = related.CategorySlug == CategorySlugs.SmallBuildingWorks ? "pricing-card-building" : (related.CategoryName == "Plumbing" ? "pricing-card-plumbing" : "pricing-card-handyman"),
                                                             CtaText = "View Details",
                                                             CtaUrl = this.Url.RouteUrl("ServiceDetails", new { categorySlug = related.CategorySlug, serviceSlug = related.Slug }),
                                                         })" />
                }
            </div>
        </section>
    }
</div>

<!-- JSON-LD Service schema structured data -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Service",
  "serviceType": @Json.Serialize(Model.Name),
  "provider": @Json.Serialize(Business.BuildAsProvider()),
  "areaServed": @Json.Serialize(Business.AreaServed())
  @if (!isQuoteOnly)
  {
    @:,"offers": { "@@type": "Offer", "price": @Json.Serialize(Model.BasePrice.ToString("F2", CultureInfo.InvariantCulture)), "priceCurrency": "GBP" }
  }
}
</script>

@if (faqJsonEntries != null)
{
    <!-- FAQ Schema: the page's own questions -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [ @Html.Raw(faqJsonEntries) ]
    }
    </script>
}

<!-- JSON-LD: BreadcrumbList -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Home", "item": @Json.Serialize(this.Url.Action("Index", "Home", null, this.Context.Request.Scheme)) },
    { "@@type": "ListItem", "position": 2, "name": "Services", "item": @Json.Serialize(this.Url.Action("Index", "Services", null, this.Context.Request.Scheme)) },
    { "@@type": "ListItem", "position": 3, "name": @Json.Serialize(Model.CategoryName), "item": @Json.Serialize(this.Url.RouteUrl("ServiceCategory", new { categorySlug = Model.CategorySlug }, this.Context.Request.Scheme)) },
    { "@@type": "ListItem", "position": 4, "name": @Json.Serialize(Model.Name), "item": @Json.Serialize(this.ViewData["Canonical"]) }
  ]
}
</script>

