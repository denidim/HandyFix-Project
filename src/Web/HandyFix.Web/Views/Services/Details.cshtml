@model HandyFix.Web.ViewModels.Services.ServiceDetailsViewModel
@using HandyFix.Web.ViewModels.Services
@{
    this.Layout = "_Layout";
    this.ViewData["Title"] = $"{Model.Name} - HandyFix Surrey & South London";

    var isPlumbing = Model.CategoryName == "Plumbing";
    var isBuilding = Model.CategorySlug == "small-building-works" || Model.CategoryName.Contains("Building");
    var durationHours = isBuilding
        ? "Day Rate / Survey"
        : (Model.EstimatedDurationMinutes >= 60 
            ? $"{(Model.EstimatedDurationMinutes / 60.0).ToString("0.#")} Hours" 
            : $"{Model.EstimatedDurationMinutes} Mins");

    // Dynamic Image path
    var serviceImage = Model.ImageUrl;

    // Feature dynamic data
    var feat1Icon = isBuilding ? "foundation" : (isPlumbing ? "faucet" : "shelves");
    var feat1Title = isBuilding ? "Site Survey & Planning" : (isPlumbing ? "Fixture Installations" : "Furniture Assembly");
    var feat1Desc = isBuilding
        ? "Detailed on-site assessment, material specification, and transparent written quotation before work starts."
        : (isPlumbing 
            ? "Expert installation of faucets, showerheads, and designer mixer taps with seamless finishing."
            : "Flat-pack furniture assembly, shelf mounting, and cabinets put together securely and efficiently.");

    var feat2Icon = isBuilding ? "construction" : (isPlumbing ? "plumbing" : "build");
    var feat2Title = isBuilding ? "Multi-Trade Execution" : (isPlumbing ? "Leak Detection" : "Home Repairs");
    var feat2Desc = isBuilding
        ? "Complete trade coverage including plastering, tiling, carpentry, and plumbing done to British building standards."
        : (isPlumbing 
            ? "Non-invasive thermal imaging and pressure testing to find and fix hidden leaks instantly."
            : "TV wall mounting, mirror hanging, door trimming, and general odd jobs handled by experts.");

    // Local Expert: the business's real co-founder on every service page. Only the role
    // adapts per category - the bio is his own supplied wording, not written per trade.
    var expertName = "Zapryan";
    var expertRole = isBuilding ? "Projects Director" : (isPlumbing ? "Owner & Lead Plumber" : "Owner & Lead Handyman");
    var expertBorough = "Surrey";
    var expertBio = "I've been in the construction industry since 2004, and I believe the secret to stress-free renovations is simple: turn up on time, manage the trades properly, and do the job right the first time. I personally survey every project and work alongside our teams on-site until the final checklist is complete.";
    var expertClosingLine = "You'll always have a direct line to me, and my personal guarantee that the work is finished to perfection.";
    var expertAvatar = "/images/expert-zap.webp";

    string GetCategoryIcon(string name)
    {
        return name switch
        {
            "Plumbing" => "water_drop",
            "Handyman" => "handyman",
            "Small Building & Refurbishments" => "foundation",
            _ => "home_repair_service",
        };
    }
}

<div class="page-container services-page">
    <!-- Hero Section -->
    <section class="service-hero-section">
        <div class="service-hero-image" id="service-hero-bg" style="background-image: url('@serviceImage')"></div>
        <div class="service-hero-overlay"></div>
        <div class="service-hero-content">
            <nav class="service-hero-breadcrumbs" aria-label="breadcrumb">
                <a asp-controller="Services" asp-action="Index">Services</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <a asp-route="ServiceCategory" asp-route-categorySlug="@Model.CategorySlug">@Model.CategoryName</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-white">@Model.Name</span>
            </nav>
            <h1 class="service-hero-title">@Model.Name Specialists</h1>
            <div class="service-hero-badges">
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">verified</span> Professional Service
                </span>
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">schedule</span> 24/7 Available
                </span>
            </div>
        </div>
    </section>

    <!-- Main Layout Container -->
    <div class="service-details-layout">
        <!-- Main Content Area -->
        <main>
            <!-- Quick Specs Bento -->
            <div class="specs-bento-grid">
                <div class="spec-bento-card">
                    <span class="material-symbols-outlined spec-bento-icon">history</span>
                    <span class="spec-bento-label">Typical Duration</span>
                    <span class="spec-bento-value">@durationHours</span>
                </div>
                <div class="spec-bento-card">
                    <span class="material-symbols-outlined spec-bento-icon">category</span>
                    <span class="spec-bento-label">Service Category</span>
                    <span class="spec-bento-value">@Model.CategoryName</span>
                </div>
                <div class="spec-bento-card col-span-2">
                    @if (isBuilding)
                    {
                        <span class="material-symbols-outlined spec-bento-icon">request_quote</span>
                        <span class="spec-bento-label">Pricing Model</span>
                        <span class="spec-bento-value">Free Survey &amp; Fixed Quote</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined spec-bento-icon">payments</span>
                        <span class="spec-bento-label">Starting Price</span>
                        <span class="spec-bento-value">From £@Model.BasePrice.ToString("F0")</span>
                    }
                </div>
            </div>

            <!-- Detailed Description -->
            <section class="details-prose">
                <h2 class="details-section-title">Service Overview</h2>
                <p>@Model.Description</p>
                <p>At <strong>HandyFix</strong>, our mobile crews are specialized in @Model.Name operations. We come equipped with professional-grade tools, quality replacement components, and follow strict building codes to ensure a lasting repair or installation. All our work is fully insured for your peace of mind.</p>

                <div class="details-features-grid">
                    <div class="details-feature-item">
                        <div class="feature-item-icon-box">
                            <span class="material-symbols-outlined">@feat1Icon</span>
                        </div>
                        <div>
                            <h3 class="feature-item-title">@feat1Title</h3>
                            <p class="feature-item-desc">@feat1Desc</p>
                        </div>
                    </div>
                    <div class="details-feature-item">
                        <div class="feature-item-icon-box">
                            <span class="material-symbols-outlined">@feat2Icon</span>
                        </div>
                        <div>
                            <h3 class="feature-item-title">@feat2Title</h3>
                            <p class="feature-item-desc">@feat2Desc</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FAQ Accordion -->
            <section class="faq-accordion-group">
                <h2 class="details-section-title">Frequently Asked Questions</h2>
                
                <details class="faq-accordion" open>
                    <summary class="faq-accordion-summary">
                        <span class="faq-accordion-title">How much does @Model.Name cost?</span>
                        <span class="material-symbols-outlined faq-accordion-icon">expand_more</span>
                    </summary>
                    <div class="faq-accordion-content">
                        @if (isBuilding)
                        {
                            <text>@Model.Name is quoted individually after a free on-site survey, so we can account for the scope, materials, and finish you want before agreeing a fixed price. There's no obligation to book once you have your quote.</text>
                        }
                        else
                        {
                            <text>Our base rate for @Model.Name starts from £@Model.BasePrice.ToString("F2"). The final cost depends on the complexity of the task and any additional materials or parts required. We always present transparent quotes before starting.</text>
                        }
                    </div>
                </details>

                <details class="faq-accordion">
                    <summary class="faq-accordion-summary">
                        <span class="faq-accordion-title">Do you cover my location?</span>
                        <span class="material-symbols-outlined faq-accordion-icon">expand_more</span>
                    </summary>
                    <div class="faq-accordion-content">
                        We operate throughout Chessington, Cobham, Esher, Weybridge, Guildford, Epsom, Kingston, Wimbledon, and surrounding areas across Surrey and South London.
                    </div>
                </details>

                <details class="faq-accordion">
                    <summary class="faq-accordion-summary">
                        <span class="faq-accordion-title">Is your @Model.Name service insured?</span>
                        <span class="material-symbols-outlined faq-accordion-icon">expand_more</span>
                    </summary>
                    <div class="faq-accordion-content">
                        Yes, absolutely. All HandyFix services, including @Model.Name, are fully backed by our comprehensive public liability insurance and 100% satisfaction guarantee.
                    </div>
                </details>
            </section>

            <!-- Local Expert Block -->
            <section class="local-expert-block">
                <div class="local-expert-avatar-wrapper">
                    <img class="local-expert-avatar" alt="@expertName - @expertRole" src="@expertAvatar" onerror="this.onerror=null;this.src='/images/hero.webp';" width="96" height="96" loading="lazy">
                </div>
                <div>
                    <span class="local-expert-meta">Your Local Expert</span>
                    <h3 class="local-expert-name">Hi, I'm @expertName – @expertRole in @expertBorough</h3>
                    <p class="local-expert-bio">@expertBio @expertClosingLine</p>
                </div>
            </section>
        </main>

        <!-- Sidebar Area -->
        <aside>
            <div class="sidebar-sticky-wrapper">
                <!-- CTA Booking Card -->
                <div class="sidebar-booking-card">
                @if (isBuilding)
                {
                    <h3 class="sidebar-booking-title">Request a Project Quote</h3>
                    <p class="sidebar-booking-desc">Discuss your project with our multi-trade building and refurbishment team across Surrey and South London.</p>
                    
                    <div class="sidebar-booking-features">
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Free site survey &amp; consultation</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Written, transparent quote in advance</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Fully insured multi-trade team</span>
                        </div>
                    </div>

                    <a asp-controller="Home" asp-action="Contact" asp-route-service="@Model.Name" class="sidebar-booking-btn">
                        <span>Request Free Estimate</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                    <p class="sidebar-booking-note">No obligation &bull; Free initial survey</p>
                }
                else
                {
                    <h3 class="sidebar-booking-title">Book This Service Now</h3>
                    <p class="sidebar-booking-desc">Expert technicians available in Sutton and surrounding areas. Fast, clean, and guaranteed.</p>
                    
                    <div class="sidebar-booking-features">
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Transparent fixed pricing</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Certified master technicians</span>
                        </div>
                        <div class="sidebar-booking-feature-item">
                            <span class="material-symbols-outlined sidebar-booking-feature-icon">check_circle</span>
                            <span>Same-day service possible</span>
                        </div>
                    </div>

                    <div class="sidebar-booking-actions">
                        <a asp-controller="Home" asp-action="Contact" asp-route-service="@Model.Name" class="sidebar-booking-btn">
                            <span>Request Your Booking</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                        <a asp-controller="Booking" asp-action="Index" asp-route-serviceId="@Model.Id" class="sidebar-booking-btn sidebar-booking-btn-outline">
                            <span class="material-symbols-outlined">calendar_month</span>
                            <span>Book a Slot</span>
                        </a>
                        <a href="tel:07123456789" class="sidebar-booking-btn sidebar-booking-btn-ghost">
                            <span class="material-symbols-outlined">call</span>
                            <span>Call Us: 07123 456 789</span>
                        </a>
                    </div>
                    <p class="sidebar-booking-note">Requests are free &bull; Slots secured with a £50 deposit</p>
                }
                </div>

                <!-- Trust Card -->
                <div class="sidebar-trust-box">
                    <h4 class="sidebar-trust-title">Why Handy Fix?</h4>
                    <div class="sidebar-trust-list">
                        <div class="sidebar-trust-item">
                            <span class="material-symbols-outlined sidebar-trust-icon">workspace_premium</span>
                            <div>
                                <p class="sidebar-trust-item-title">Fully Insured</p>
                                <p class="sidebar-trust-item-desc">Comprehensive public liability insurance.</p>
                            </div>
                        </div>
                        <div class="sidebar-trust-item">
                            <span class="material-symbols-outlined sidebar-trust-icon">health_and_safety</span>
                            <div>
                                <p class="sidebar-trust-item-title">Clean &amp; Tidy</p>
                                <p class="sidebar-trust-item-desc">We always wear shoe covers and clean up.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    @if (Model.RelatedServices != null && Model.RelatedServices.Any())
    {
        <!-- You Might Also Need -->
        <section class="pricing-typical-jobs-section">
            <h2 class="font-headline-lg text-primary text-center pricing-section-title">You Might Also Need</h2>
            <p class="font-body-md text-on-surface-variant text-center pricing-section-subtitle">
                Other @Model.CategoryName.ToLower() services our customers often book alongside this one.
            </p>

            <div class="pricing-cards-grid">
                @foreach (var related in Model.RelatedServices)
                {
                    <partial name="_PricingCard" model="@(new PricingCardViewModel
                                                         {
                                                             Name = related.Name,
                                                             IconName = GetCategoryIcon(related.CategoryName),
                                                             ImageUrl = related.ImageUrl,
                                                             Description = related.Description,
                                                             BasePrice = related.BasePrice,
                                                             EstimatedDurationMinutes = related.EstimatedDurationMinutes,
                                                             IsQuoteBased = related.CategorySlug == "small-building-works",
                                                             CtaText = "View Details",
                                                             CtaUrl = this.Url.RouteUrl("ServiceDetails", new { categorySlug = related.CategorySlug, serviceSlug = related.Slug }),
                                                         })" />
                }
            </div>
        </section>
    }
</div>

<!-- JSON-LD Service schema structured data -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Service",
  "serviceType": "@Model.Name",
  "provider": {
    "@@type": "LocalBusiness",
    "name": "HandyFix",
    "telephone": "07123456789",
    "priceRange": "££",
    "address": {
      "@@type": "PostalAddress",
      "addressLocality": "Chessington",
      "addressRegion": "Surrey",
      "addressCountry": "GB"
    }
  },
  "areaServed": [
    { "@@type": "AdministrativeArea", "name": "Surrey" },
    { "@@type": "AdministrativeArea", "name": "South London" },
    { "@@type": "AdministrativeArea", "name": "Chessington" },
    { "@@type": "AdministrativeArea", "name": "Cobham" },
    { "@@type": "AdministrativeArea", "name": "Esher" },
    { "@@type": "AdministrativeArea", "name": "Guildford" },
    { "@@type": "AdministrativeArea", "name": "Epsom" },
    { "@@type": "AdministrativeArea", "name": "Kingston" }
  ]
  @if (!isBuilding)
  {
    @:,"offers": { "@@type": "Offer", "price": "@Model.BasePrice.ToString("F2")", "priceCurrency": "GBP" }
  }
}
</script>

<!-- FAQ Schema -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "How much does @Model.Name cost?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "@(isBuilding ? $"{Model.Name} is quoted individually after a free on-site survey, so pricing depends on the scope and finish you want." : $"Our base rate for {Model.Name} starts from £{Model.BasePrice:F2}.")"
      }
    },
    {
      "@@type": "Question",
      "name": "Do you cover my location?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "We operate throughout Chessington, Cobham, Esher, Weybridge, Guildford, Epsom, Kingston, Wimbledon, and surrounding areas across Surrey and South London."
      }
    }
  ]
}
</script>

<script>
    (function () {
        var heroBg = document.getElementById("service-hero-bg");
        var probe = new Image();
        probe.onerror = function () {
            heroBg.style.backgroundImage = "url('/images/hero.webp')";
        };
        probe.src = "@serviceImage";
    })();
</script>
