@model IEnumerable<HandyFix.Web.ViewModels.Services.CategoryViewModel>
@{
    this.ViewData["Title"] = "All Services - Plumbing Handyman Surrey";
}

<div class="page-container services-page">
    <!-- Hero Section -->
    <section class="service-hero-section">
        <div class="service-hero-image" style="background-image: url('/images/services-hero.webp')"></div>
        <div class="service-hero-overlay"></div>
        <div class="service-hero-content">
            <nav class="service-hero-breadcrumbs" aria-label="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-white">Services</span>
            </nav>
            <h1 class="service-hero-title">Professional Property Maintenance &amp; Building in Surrey &amp; South London.</h1>
            <p class="text-white-80 font-body-lg" style="max-width: 640px;">
                Reliable plumbing, expert handyman tasks, and small building works across Surrey and South London, including Chessington, Cobham, and Epsom. Transparent pricing and guaranteed craftsmanship on every job.
            </p>
        </div>
    </section>

    <!-- Specialised Divisions Grid -->
    <section class="section py-8">
        <div class="divisions-grid">
            @foreach (var category in this.Model)
            {
                var isPlumbing = category.Slug == "plumbing" || string.Equals(category.Name, "Plumbing", StringComparison.OrdinalIgnoreCase);
                var isBuilding = category.Slug == "small-building-works" || category.Name.Contains("Building", StringComparison.OrdinalIgnoreCase);

                var divisionClass = isBuilding ? "division-card-building" : (isPlumbing ? "division-card-plumbing" : "division-card-handyman");
                var categoryIcon = isBuilding ? "foundation" : (isPlumbing ? "water_drop" : "handyman");
                var categoryTitle = isBuilding ? "Building & Refurb" : (isPlumbing ? "Plumbing & Heating" : "General Handyman");
                var categoryHero = isBuilding ? "small-building-category-hero.webp" : (isPlumbing ? "plumbing-category-hero.webp" : "handyman-category-hero.webp");
                var linkText = isBuilding ? "View Building Works" : (isPlumbing ? "View Plumbing Rates" : "View Handyman Rates");

                var sampleServices = isBuilding
                    ? new[] { "Bathroom Refurb", "Kitchen Fitting", "Partition Walls", "Plastering & Tiling" }
                    : (isPlumbing
                        ? new[] { "Leak Detection", "Boiler Service", "Drainage Solutions", "Tap Replacement" }
                        : new[] { "Furniture Assembly", "TV Mounting", "Door Repairs", "Shelf Installation" });

                <div class="division-card @divisionClass">
                    <div class="img-container">
                        <img src="~/images/services/@categoryHero" alt="@category.Name" asp-append-version="true" width="1024" height="1024" loading="lazy" onerror="this.onerror=null;this.src='/images/hero.webp';">
                    </div>
                    <div class="division-card-content">
                        <div class="division-header-title">
                            <span class="material-symbols-outlined text-secondary division-icon-lg">@categoryIcon</span>
                            <h3 class="font-headline-md m-0">@categoryTitle</h3>
                        </div>
                        <p class="text-text-main font-body-md mb-6 lh-relaxed">
                            @category.Description
                        </p>
                        <ul class="division-services-list">
                            @foreach (var item in sampleServices)
                            {
                                <li class="division-service-item">
                                    <span class="material-symbols-outlined text-secondary division-check-icon">check</span>
                                    @item
                                </li>
                            }
                        </ul>
                        <a class="division-link" asp-route="ServiceCategory" asp-route-categorySlug="@category.Slug">
                            @linkText
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Local Quality Proof -->
    <section class="quality-proof-section">
        <div class="page-container quality-proof-container">
            <div class="quality-proof-content">
                <h2 class="quality-proof-title">Why choose Handy Fix for your property?</h2>
                <p class="quality-proof-desc">
                    We pride ourselves on technical mastery and absolute reliability. Our team serves the Surrey and South London area with a focus on high-fidelity results and transparent communication.
                </p>
                <div class="quality-proof-badges">
                    <div class="proof-badge">
                        <span class="material-symbols-outlined proof-badge-icon">verified</span>
                        <span>Fully Insured</span>
                    </div>
                    <div class="proof-badge">
                        <span class="material-symbols-outlined proof-badge-icon">payments</span>
                        <span>Fixed Rates Upfront</span>
                    </div>
                    <div class="proof-badge">
                        <span class="material-symbols-outlined proof-badge-icon">schedule</span>
                        <span>Same-Day Visits</span>
                    </div>
                </div>
            </div>
            <div class="quality-proof-image-wrapper">
                <div class="quality-proof-image-container">
                    <img class="quality-proof-image" alt="A professional tradesperson in Surrey and South London" src="/images/hero.webp" width="256" height="256" loading="lazy">
                </div>
            </div>
        </div>
    </section>
</div>
