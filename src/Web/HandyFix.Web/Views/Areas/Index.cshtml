@model IEnumerable<HandyFix.Web.ViewModels.ServiceAreas.ServiceAreaViewModel>
@{
    var itemListEntries = string.Join(",", Model.Select((a, i) =>
        $"{{ \"@type\": \"ListItem\", \"position\": {i + 1}, \"name\": {System.Text.Json.JsonSerializer.Serialize(a.Name)}, \"url\": {System.Text.Json.JsonSerializer.Serialize(this.Url.RouteUrl("AreaDetails", new { areaSlug = a.Slug }, this.Context.Request.Scheme))} }}"));
}

<div class="page-container services-page">
    <!-- Hero Section -->
    <section class="service-hero-section">
        <div class="service-hero-image" style="background-image: url('/images/areas-hero.webp')"></div>
        <div class="service-hero-overlay"></div>
        <div class="service-hero-content">
            <nav class="service-hero-breadcrumbs" aria-label="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-white">Our Areas</span>
            </nav>
            <h1 class="service-hero-title">Our Areas.</h1>
            <p class="text-white-80 font-body-lg mb-4" style="max-width: 640px;">
                From our Chessington base out across South London and Surrey, our technicians already know the streets, the property types, and the postcodes. Find your town below and book online today.
            </p>
            <div class="service-hero-badges">
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">location_on</span> @Model.Count() Areas Covered
                </span>
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">schedule</span> No Travel Charge In-Radius
                </span>
            </div>
        </div>
    </section>

    <!-- Coverage Map -->
    <section class="areas-overview-hero">
        <partial name="_AreaCoverageMap" model="Model" />
    </section>

    <!-- Featured Areas -->
    <section class="areas-section">
        <h2 class="font-headline-lg text-primary text-center areas-section-title">Featured Areas</h2>
        <p class="font-body-md text-on-surface-variant text-center areas-section-subtitle">Our busiest coverage zones, closest to the Chessington base.</p>
        <vc:area-card featured-only="true" take="6"></vc:area-card>
    </section>

    <!-- All Areas -->
    <section class="areas-section">
        <h2 class="font-headline-lg text-primary text-center areas-section-title">All Areas We Cover</h2>
        <p class="font-body-md text-on-surface-variant text-center areas-section-subtitle">Every town and village within our standard service radius.</p>
        <vc:area-card take="20"></vc:area-card>
    </section>

    <!-- CTA -->
    <div class="pricing-cta-actions">
        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg">Book Appointment Now</a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary btn-lg">Ask About Your Area</a>
    </div>
</div>

<!-- JSON-LD: ItemList of all coverage areas -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "ItemList",
  "itemListElement": [ @Html.Raw(itemListEntries) ]
}
</script>
