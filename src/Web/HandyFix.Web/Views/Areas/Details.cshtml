@model HandyFix.Web.ViewModels.ServiceAreas.ServiceAreaDetailsPageViewModel
@using HandyFix.Web.ViewModels.Services
@inject HandyFix.Web.Services.IBusinessRecord Business
@{
    this.Layout = "_Layout";

    var area = Model.Area;

    // The picture is the admin's upload, else the one that came with the site, else the general
    // one. A phone draws it to fill a box 400px tall, so only a strip from its middle shows, and it
    // is sent that strip (PROJECT_STATE Sections 3cz and 3dl). The controller looks both up before
    // the page is drawn.
    var picture = Model.Picture ?? "/images/hero.webp";
    var phonePicture = Model.PhonePicture;
    var driveTimeText = area.DriveTimeMinutes == 0 ? "Home Base" : $"~{area.DriveTimeMinutes} min from Chessington";

    var faqJsonEntries = area.Faqs != null && area.Faqs.Any()
        ? string.Join(",", area.Faqs.Select(f =>
            $"{{ \"@type\": \"Question\", \"name\": {System.Text.Json.JsonSerializer.Serialize(f.Question)}, \"acceptedAnswer\": {{ \"@type\": \"Answer\", \"text\": {System.Text.Json.JsonSerializer.Serialize(f.Answer)} }} }}"))
        : null;
}

<div class="page-container services-page">
    <!-- Hero -->
    <section class="service-hero-section">
        <picture>
            @if (phonePicture != null)
            {
                <source media="(max-width: 575.98px)" srcset="@phonePicture" width="928" height="700">
            }
            <img src="@picture"
                 alt="Handyman and plumbing services in @area.Name"
                 class="area-hero-image"
                 asp-append-version="true"
                 width="1600" height="700"
                 loading="eager" fetchpriority="high"
                 onerror="this.src='/images/hero.webp';" />
        </picture>
        <div class="service-hero-overlay"></div>
        <div class="service-hero-content">
            <nav class="service-hero-breadcrumbs" aria-label="breadcrumb">
                <a asp-route="Areas">Our Areas</a>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span class="text-white">@area.Name</span>
            </nav>
            <h1 class="service-hero-title">Plumber &amp; Handyman in @area.Name</h1>
            <div class="service-hero-badges">
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">verified</span> Professional Service
                </span>
                <span class="glass-card px-4 py-2 rounded-full text-white text-label-sm font-label-sm flex items-center gap-2">
                    <span class="material-symbols-outlined">directions_car</span> @driveTimeText
                </span>
            </div>
        </div>
    </section>

        <!-- Quick Specs Bento -->
    <div class="specs-bento-grid">
        <div class="spec-bento-card">
            <span class="material-symbols-outlined spec-bento-icon">event_available</span>
            <span class="spec-bento-label">Availability</span>
            <span class="spec-bento-value">Same-day &amp; next-day slots available</span>
        </div>
        <div class="spec-bento-card">
            <span class="material-symbols-outlined spec-bento-icon">security</span>
            <span class="spec-bento-label">Peace of Mind</span>
            <span class="spec-bento-value">Fully insured &amp; vetted local technicians</span>
        </div>
        <div class="spec-bento-card col-span-2">
            <span class="material-symbols-outlined spec-bento-icon">payments</span>
            <span class="spec-bento-label">Pricing</span>
            <span class="spec-bento-value">Transparent hourly rates, no travel charge in-radius</span>
        </div>
    </div>

    <!-- Description -->
    <section class="details-prose">
        <h2 class="details-section-title">About @area.Name</h2>
        @* Each text in its paragraphs: a blank line in the admin's box starts a new one. *@
        @foreach (var paragraph in Paragraphs.Of(area.IntroCopy).Concat(Paragraphs.Of(area.LocalNeighbourhoodsCopy)))
        {
            <p>@paragraph</p>
        }

        @* The same line on every town's page, in the company's own words: the rates as the Pricing
           page works them out, and the deposit from Deposit (PROJECT_STATE Section 3em). *@
        <p class="area-booking-line">
            @if (Model.PlumbingRate.HasValue && Model.HandymanRate.HasValue)
            {
                <text>Plumbing is £@Model.PlumbingRate.Value.ToString("F0") an hour and handyman work £@Model.HandymanRate.Value.ToString("F0"), with a one-hour minimum.</text>
            }
            Pick a time that suits you and pay online: a £@Deposit.Pounds deposit secures your slot and comes off the final bill.
        </p>
    </section>

    <!-- Related Services -->
    @if (Model.RelatedServices != null && Model.RelatedServices.Any())
    {
        <section class="pricing-typical-jobs-section">
            @* The town's own four (AreaServices), each with its short text and a link to its page;
               the full description is on that page only (PROJECT_STATE Section 3el). *@
            <h2 class="details-section-title text-center">Services in @area.Name</h2>
            <div class="pricing-cards-grid">
                @foreach (var svc in Model.RelatedServices)
                {
                    var isQuoteOnly = svc.CategorySlug == CategorySlugs.SmallBuildingWorks || svc.IsQuoteOnly;
                    <partial name="_PricingCard" model="@(new PricingCardViewModel
                                                         {
                                                             Name = svc.Name,
                                                             IconName = svc.CategorySlug == CategorySlugs.SmallBuildingWorks ? "foundation" : (svc.CategoryName == "Plumbing" ? "water_drop" : "handyman"),
                                                             ImageUrl = svc.ImageUrl,
                                                             MediumCopyUrl = svc.MediumCopyUrl,
                                                             Description = Summaries.Of(svc.Summary, svc.Description),
                                                             DetailsUrl = this.Url.RouteUrl("ServiceDetails", new { categorySlug = svc.CategorySlug, serviceSlug = svc.Slug }),
                                                             BasePrice = svc.BasePrice,
                                                             EstimatedDurationMinutes = svc.EstimatedDurationMinutes,
                                                             IsQuoteBased = isQuoteOnly,
                                                             DivisionClass = svc.CategorySlug == CategorySlugs.SmallBuildingWorks ? "pricing-card-building" : (svc.CategoryName == "Plumbing" ? "pricing-card-plumbing" : "pricing-card-handyman"),
                                                             CtaText = isQuoteOnly ? "Request Quote" : (svc.IsEmergency ? "24/7 by Phone" : "Book Now"),
                                                             CtaUrl = isQuoteOnly
                                                                 ? this.Url.Action("Contact", "Home", new { service = svc.Name })
                                                                 : (svc.IsEmergency
                                                                     ? this.Url.RouteUrl("ServiceDetails", new { categorySlug = svc.CategorySlug, serviceSlug = svc.Slug })
                                                                     : this.Url.Action("Index", "Booking", new { selectedServiceId = svc.Id, categorySlug = svc.CategorySlug })),
                                                         })" />
                }
            </div>
        </section>
    }

    <!-- FAQ Accordion -->
    @if (area.Faqs != null && area.Faqs.Any())
    {
        <section class="faq-accordion-group">
            <h2 class="details-section-title">@area.Name Handyman &amp; Plumbing FAQs</h2>
            @foreach (var faq in area.Faqs)
            {
                <details class="faq-accordion">
                    <summary class="faq-accordion-summary">
                        <span class="faq-accordion-title">@faq.Question</span>
                        <span class="material-symbols-outlined faq-accordion-icon">expand_more</span>
                    </summary>
                    <div class="faq-accordion-content">
                        @faq.Answer
                    </div>
                </details>
            }
        </section>
    }

    <!-- Reviews -->
    @* This town's own Google reviews only (PROJECT_STATE Section 3eh); with none, no section. *@
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <section class="area-reviews-section">
            <h2 class="details-section-title text-center">What Our Customers in @Model.Area.Name Say</h2>
            <div class="review-feed">
                @foreach (var review in Model.Reviews)
                {
                    <partial name="_ReviewCard" model="review" />
                }
            </div>
        </section>
    }

    <!-- Nearby Areas -->
    <section class="areas-section">
        <h2 class="font-headline-lg text-primary text-center areas-section-title">Nearby Areas We Also Cover</h2>
        <vc:area-card exclude-area-id="@area.Id" take="4"></vc:area-card>
    </section>

    <!-- CTA -->
    <div class="pricing-cta-actions">
        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg">Book Appointment in @area.Name</a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary btn-lg">Get a Custom Quote</a>
    </div>
</div>

<!-- JSON-LD: Service / LocalBusiness -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Service",
  "serviceType": "Handyman and Plumbing Services",
  "areaServed": {
    "@@type": "City",
    "name": @Json.Serialize(area.Name)
  },
  "provider": @Json.Serialize(Business.BuildAsProvider())
}
</script>

@if (faqJsonEntries != null)
{
    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [ @Html.Raw(faqJsonEntries) ]
    }
    </script>
}

<!-- JSON-LD: BreadcrumbList -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "BreadcrumbList",
  "itemListElement": [
    { "@@type": "ListItem", "position": 1, "name": "Home", "item": @Json.Serialize($"{this.Context.Request.Scheme}://{this.Context.Request.Host}/") },
    { "@@type": "ListItem", "position": 2, "name": "Our Areas", "item": @Json.Serialize(this.Url.RouteUrl("Areas", null, this.Context.Request.Scheme)) },
    { "@@type": "ListItem", "position": 3, "name": @Json.Serialize(area.Name), "item": @Json.Serialize(this.ViewData["Canonical"]) }
  ]
}
</script>
