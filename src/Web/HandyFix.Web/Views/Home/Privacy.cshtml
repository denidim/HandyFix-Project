@{
    this.ViewData["Title"] = "Privacy Policy";
}

<div class="page-container services-page">
    <!-- Header & Breadcrumbs -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">Privacy</span>
        </nav>
        <div class="services-header-content text-center">
            <h1 class="services-hero-title">Privacy <span>Policy.</span></h1>
            <p class="font-label-sm text-on-surface-variant font-medium opacity-70 fs-14">Last updated: 23 September 2026</p>
        </div>
    </section>

    <!-- Content Canvas -->
    <div class="info-canvas">
    <!-- Main Content Card -->
    <div class="info-card">
        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">info</span>
                <h2>1. Who We Are</h2>
            </div>
            <p class="font-body-lg text-on-surface-variant leading-relaxed">
                This policy explains what personal data Plumbing Handyman Surrey collects through this website, why we collect it, who else handles it, and how long we keep it. We are responsible for this data (the "data controller"). If you have any questions, email us at <a href="mailto:info@plumbing-handyman-surrey.co.uk">info@plumbing-handyman-surrey.co.uk</a>.
            </p>
        </section>

        <hr class="info-section-divider" />

        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">inventory_2</span>
                <h2>2. Information We Collect</h2>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="p-4 rounded-lg h-100 info-feature-card">
                        <h3 class="font-headline-sm text-secondary mb-2">Bookings</h3>
                        <p class="text-on-surface-variant mb-0 fs-14">Your name, email address, phone number, the address where the work is needed, a description of the problem, any photos you add, and the time slot you choose.</p>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="p-4 rounded-lg h-100 info-feature-card">
                        <h3 class="font-headline-sm text-secondary mb-2">Enquiries</h3>
                        <p class="text-on-surface-variant mb-0 fs-14">Your name, email address, phone number, the type of work, your message, and any photos you add.</p>
                    </div>
                </div>
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="p-4 rounded-lg h-100 info-feature-card">
                        <h3 class="font-headline-sm text-secondary mb-2">Job Applications</h3>
                        <p class="text-on-surface-variant mb-0 fs-14">Your name, email address, phone number, trade, years of experience, availability, whether you have your own tools and transport, and anything you tell us about yourself.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-4 rounded-lg h-100 info-feature-card">
                        <h3 class="font-headline-sm text-secondary mb-2">No Tracking</h3>
                        <p class="text-on-surface-variant mb-0 fs-14">We don't use analytics, advertising or tracking tools. We only set the essential cookies described in our <a asp-controller="Home" asp-action="CookiePolicy">Cookie Policy</a>.</p>
                    </div>
                </div>
            </div>
        </section>

        <hr class="info-section-divider" />

        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">analytics</span>
                <h2>3. How We Use Information</h2>
            </div>
            <p class="font-body-md text-on-surface-variant mb-3">
                We use your information only to:
            </p>
            <ul class="d-flex flex-column gap-2 p-0 list-unstyled">
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                    <span>Arrange and carry out the work you've booked or asked us about.</span>
                </li>
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                    <span>Contact you about your booking, enquiry or application, including booking confirmation emails.</span>
                </li>
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                    <span>Keep the business records the law requires, such as payment records for tax.</span>
                </li>
            </ul>
            <p class="font-body-md text-on-surface-variant mb-0">
                We never sell your data, and we don't use it for marketing.
            </p>
        </section>

        <hr class="info-section-divider" />

        <!-- Featured Section: Who handles the data -->
        <section class="p-4 p-md-5 text-white rounded-xl info-feature-dark">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="material-symbols-filled text-secondary-container">security</span>
                <h2 class="font-headline-md text-white mb-0">4. Who Else Handles Your Data</h2>
            </div>
            <p class="font-body-lg opacity-90 leading-relaxed mb-4">
                A few trusted services help us run the website. Each one only gets what it needs: our website and database run on servers in the EU (Hetzner, Finland); booking and enquiry emails are sent through Brevo; photos you upload are stored with Cloudflare; and the fonts on our pages load from Google Fonts, so your browser connects to Google's servers when you visit.
            </p>
            <div class="p-4 rounded-lg d-flex flex-column flex-md-row align-items-center gap-4 info-feature-translucent">
                <div class="flex-grow-1">
                    <p class="text-white font-bold mb-1 stripe-card-label">Card Payments</p>
                    <p class="mb-0 text-white stripe-card-text">Deposits are paid on Stripe's secure checkout page. Your card details go straight to Stripe and never reach our servers; Stripe only tells us the amount and whether it was paid.</p>
                </div>
                <div class="font-bold text-white tracking-widest text-center stripe-badge">
                    STRIPE
                </div>
            </div>
        </section>

        <hr class="info-section-divider" />

        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">schedule</span>
                <h2>5. How Long We Keep It</h2>
            </div>
            <ul class="d-flex flex-column gap-2 p-0 list-unstyled">
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-secondary mt-1 fs-18">arrow_right</span>
                    <span><strong>Bookings and payment records:</strong> 6 years, as UK tax law requires.</span>
                </li>
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-secondary mt-1 fs-18">arrow_right</span>
                    <span><strong>Enquiries:</strong> 12 months after we last hear from you, unless they turn into a booking.</span>
                </li>
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-secondary mt-1 fs-18">arrow_right</span>
                    <span><strong>Job applications:</strong> 6 months after we reply.</span>
                </li>
                <li class="d-flex align-items-start gap-3">
                    <span class="material-symbols-outlined text-secondary mt-1 fs-18">arrow_right</span>
                    <span><strong>Photos:</strong> deleted together with the booking or enquiry they belong to.</span>
                </li>
            </ul>
        </section>

        <hr class="info-section-divider" />

        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">verified_user</span>
                <h2>6. Your Rights</h2>
            </div>
            <p class="font-body-md text-on-surface-variant mb-0">
                Under UK data protection law you can ask us for a copy of your data, ask us to correct it or delete it, or object to how we use it. Email us and we'll respond within one month. If you're unhappy with how we handle your data, you can complain to the Information Commissioner's Office at <a href="https://ico.org.uk" target="_blank" rel="noopener">ico.org.uk</a>.
            </p>
        </section>

        <hr class="info-section-divider" />

        <section class="info-section">
            <div class="info-section-title-row">
                <span class="material-symbols-filled text-secondary">mail</span>
                <h2>7. Contact Us</h2>
            </div>
            <div class="p-4 rounded-lg info-feature-light">
                <p class="font-body-md text-primary mb-4">
                    Questions about this policy or your data? Get in touch:
                </p>
                <div class="contact-details-stack">
                    <p class="d-flex align-items-center gap-2 text-secondary mb-0 fs-14 fw-bold">
                        <span class="material-symbols-outlined text-secondary fs-18">alternate_email</span>
                        <a href="mailto:info@plumbing-handyman-surrey.co.uk">info@plumbing-handyman-surrey.co.uk</a>
                    </p>
                    <p class="d-flex align-items-center gap-2 mb-0 text-primary fs-14">
                        <span class="material-symbols-outlined text-secondary fs-18">call</span>
                        <a href="tel:07123456789">07123 456789</a>
                    </p>
                </div>
            </div>
        </section>
    </div>

    <!-- Download PDF Button -->
    <div class="mt-4 d-flex justify-content-center">
        <button onclick="window.print()" class="btn btn-outline d-flex align-items-center gap-2 px-5 py-3 rounded-full info-print-btn">
            <span class="material-symbols-outlined">download</span>
            <span class="font-button-text">Download as PDF</span>
        </button>
    </div>
    </div>
</div>
