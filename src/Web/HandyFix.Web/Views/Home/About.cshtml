@model HandyFix.Web.ViewModels.Home.AboutViewModel
@* Who we are and what a visitor can check about us (the SEO master plan's item 7). Until then
   this was a second services page, with promises nobody had confirmed and with the rates and
   ten towns typed in by hand. Every line here is one the site already makes elsewhere; the
   rates are the admin's prices and the towns are the database's, so neither goes stale. *@
@{
    var plumbingRate = Model.Rates.Plumbing.ToString("F0");
    var handymanRate = Model.Rates.Handyman.ToString("F0");
}

<div class="page-container services-page">
    <!-- Who we are -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">About Us</span>
        </nav>
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-7">
                <div class="services-header-content">
                    <span class="about-hero-tag">Based in Chessington</span>
                    <h1 class="services-hero-title">About <span>Plumbing Handyman Surrey</span></h1>
                    <p class="services-subtitle">
                        We are a plumbing and handyman firm based in Chessington, working within 15 miles of it across Surrey and South London. We do three kinds of work: plumbing, handyman jobs, and small building and refurbishment.
                    </p>
                    <p class="services-subtitle">
                        For plumbing and handyman work you pick a time that suits you online. For building work we come to see the job first and give you a fixed quote.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary px-4 py-3 rounded-lg fw-semibold">Book a Slot</a>
                        <a asp-route="Areas" class="btn btn-outline px-4 py-3 rounded-lg fw-semibold info-print-btn">Areas We Cover</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                @* A real job of ours, the same photo as the Google profile's cover. *@
                <div class="narrative-image-wrapper about-job-photo">
                    <img src="~/images/about-job.webp" alt="A technician in a high-visibility jacket checks a metal wall frame with a spirit level." asp-append-version="true" width="1200" height="900" />
                </div>
            </div>
        </div>

        <partial name="_OwnerCard" model="@("Hi, I'm Zapryan, the owner")" />
    </section>

    <!-- What we do -->
    <section class="my-5">
        <div class="max-w-7xl mx-auto text-center mb-5">
            <h2 class="font-headline-lg text-primary mb-0">What We <span class="text-secondary">Do</span></h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="hub-pillar-card pillar-plumbing h-100 d-flex flex-column">
                    <div class="hub-pillar-icon plumbing-icon mb-3">
                        <span class="material-symbols-outlined">plumbing</span>
                    </div>
                    <div class="hub-badge mb-2">£@plumbingRate an hour</div>
                    <h3 class="fs-20 fw-bold text-primary mb-2">Plumbing</h3>
                    <p class="text-on-surface-variant fs-14 mb-4 flex-grow-1">
                        Taps, toilets, leaks, radiators and showers, repaired or fitted. A burst pipe or a flood is taken by phone or WhatsApp at any hour.
                    </p>
                    <ul class="hub-feature-list mb-4">
                        <li><span class="material-symbols-outlined fs-16">check</span> Tap and toilet repairs</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Leak and pipe repairs</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Radiators and valves</li>
                    </ul>
                    <a asp-route="ServiceCategory" asp-route-categorySlug="@CategorySlugs.Plumbing" class="btn btn-secondary text-white rounded-lg py-2 fs-14 fw-semibold mt-auto">
                        See Plumbing Services
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="hub-pillar-card pillar-handyman h-100 d-flex flex-column">
                    <div class="hub-pillar-icon handyman-icon mb-3">
                        <span class="material-symbols-outlined">handyman</span>
                    </div>
                    <div class="hub-badge mb-2">£@handymanRate an hour</div>
                    <h3 class="fs-20 fw-bold text-primary mb-2">Handyman</h3>
                    <p class="text-on-surface-variant fs-14 mb-4 flex-grow-1">
                        Shelves, TVs and furniture put up, doors and locks put right, and baths and showers resealed.
                    </p>
                    <ul class="hub-feature-list mb-4">
                        <li><span class="material-symbols-outlined fs-16">check</span> TV and shelf mounting</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Door and lock repairs</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Bath and shower resealing</li>
                    </ul>
                    <a asp-route="ServiceCategory" asp-route-categorySlug="@CategorySlugs.Handyman" class="btn btn-secondary text-white rounded-lg py-2 fs-14 fw-semibold mt-auto">
                        See Handyman Services
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-12">
                <div class="hub-pillar-card pillar-building h-100 d-flex flex-column">
                    <div class="hub-pillar-icon building-icon mb-3">
                        <span class="material-symbols-outlined">construction</span>
                    </div>
                    <div class="hub-badge building-badge mb-2">Fixed quote after a free survey</div>
                    <h3 class="fs-20 fw-bold text-primary mb-2">Small Building &amp; Refurbishment</h3>
                    <p class="text-on-surface-variant fs-14 mb-4 flex-grow-1">
                        Bathrooms and kitchens fitted, walls plastered and tiled, floors laid and partition walls built. We come to see the job first, free of charge, and give you a fixed quote before any work starts.
                    </p>
                    <ul class="hub-feature-list mb-4">
                        <li><span class="material-symbols-outlined fs-16">check</span> Bathroom refurbishment</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Kitchen fitting</li>
                        <li><span class="material-symbols-outlined fs-16">check</span> Tiling and plastering</li>
                    </ul>
                    <a asp-route="ServiceCategory" asp-route-categorySlug="@CategorySlugs.SmallBuildingWorks" class="btn btn-secondary text-white rounded-lg py-2 fs-14 fw-semibold mt-auto">
                        See Building Services
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- What you can check -->
    @* Only in the words the site already uses: no registration number and no insured sum is
       shown, and nothing is said about reviews beyond where to read them. *@
    <section class="guarantees-section mb-5">
        <div class="max-w-7xl mx-auto text-center mb-5">
            <h2 class="font-headline-lg text-primary mb-0">What You Can <span class="text-secondary">Check</span></h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">Gas work</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-0">
                        All boiler work is carried out by a Gas Safe registered engineer.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">verified_user</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">Insurance</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-0">
                        We carry public liability insurance.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">apartment</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">The company</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-0">
                        @GlobalConstants.SystemName is a trading name of @GlobalConstants.CompanyLegalName, company number @GlobalConstants.CompanyNumber, registered in England and Wales.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">payments</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">Prices in the open</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-3">
                        Plumbing is £@plumbingRate an hour and handyman work £@handymanRate, with a one-hour minimum, no call-out fee and no VAT on top.
                    </p>
                    <a asp-route="Pricing" class="text-secondary fw-semibold fs-14 d-inline-flex align-items-center gap-1">
                        <span>See our prices</span>
                        <span class="material-symbols-outlined fs-16">arrow_forward</span>
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">do_not_disturb_on</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">What we do not do</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-0">
                        Every service page lists what is not included. For example: drains outside the house, carpets, driveways, and walls that hold up a floor or the roof.
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="guarantee-card h-100">
                    <div class="guarantee-icon-box">
                        <span class="material-symbols-outlined">rate_review</span>
                    </div>
                    <h3 class="fs-18 fw-bold text-primary mb-2">Reviews</h3>
                    <p class="font-body-md text-on-surface-variant fs-14 mb-3">
                        The reviews our customers left on Google are on our Reviews page.
                    </p>
                    <a asp-controller="Home" asp-action="Reviews" class="text-secondary fw-semibold fs-14 d-inline-flex align-items-center gap-1">
                        <span>Read the reviews</span>
                        <span class="material-symbols-outlined fs-16">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Where we work -->
    <section class="about-areas-preview mb-5 p-4 p-md-5 rounded-xl border">
        <span class="text-secondary fw-semibold fs-14 text-uppercase tracking-wide d-block mb-1">Where We Work</span>
        <h2 class="fs-24 fw-bold text-primary mb-3">Based in Chessington</h2>
        <p class="text-on-surface-variant mb-4">
            We work within 15 miles of Chessington, and there is no travel charge within our standard service area. Each town below has its own page, with the postcodes we cover there.
        </p>
        @* Every town that has a page, nearest first: a town added in the admin shows here by itself. *@
        <div class="service-towns mb-4">
            @foreach (var town in Model.Towns)
            {
                <a asp-route="AreaDetails" asp-route-areaSlug="@town.Slug">@town.Name</a>
            }
        </div>
        <a asp-route="Areas" class="text-secondary fw-semibold fs-14 d-inline-flex align-items-center gap-1">
            <span>View all areas</span>
            <span class="material-symbols-outlined fs-16">arrow_forward</span>
        </a>
    </section>

    <!-- Dual Action CTA -->
    <section class="about-cta-section">
        <div class="about-cta-card">
            <div class="about-cta-card-pattern"></div>
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-4 position-relative z-1">
                <div>
                    <h2 class="font-headline-lg text-primary mb-2">Ready to Get Started?</h2>
                    <p class="font-body-lg text-on-surface-variant mb-0">
                        Pick a time that suits you online for plumbing and handyman work, or ask us for a quote for building work.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Booking" asp-action="Index" class="btn btn-secondary px-4 py-3 d-flex align-items-center gap-2 shadow-sm rounded-lg fs-15 fw-semibold text-white">
                        <span class="material-symbols-outlined fs-18">calendar_month</span>
                        <span>Book a Slot</span>
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline px-4 py-3 d-flex align-items-center gap-2 rounded-lg fs-15 fw-semibold">
                        <span class="material-symbols-outlined fs-18">mail</span>
                        <span>Request a Quote</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
