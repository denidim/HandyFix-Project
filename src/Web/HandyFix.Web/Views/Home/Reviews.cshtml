@model HandyFix.Web.ViewModels.Reviews.ReviewsListViewModel
@{
    this.ViewData["Title"] = "Customer Reviews - Handy Fix";
}

<div class="page-container services-page">
    <!-- Header & Breadcrumbs -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">Reviews</span>
        </nav>
        <div class="services-header-content">
            <h1 class="services-hero-title">What Our <span>Clients Say.</span></h1>
            <p class="services-subtitle">
                Discover why thousands of homeowners trust Handy Fix for their maintenance needs. Verified reviews from our community.
            </p>
        </div>
    </section>

    @if (Model.ShowOnSiteReviews)
    {
        <div class="reviews-container mt-12">
            <!-- Sidebar: Google Reviews CTA -->
            <aside class="order-2 order-lg-1">
                <div class="glass-card rounded-xl p-4 sticky-top reviews-sidebar-sticky text-center">
                    <span class="material-symbols-outlined text-secondary fs-36 mb-2">rate_review</span>
                    <h2 class="font-headline-md text-primary mb-2">Loved our work?</h2>
                    <p class="text-muted mb-4">We'd love it if you shared your experience on Google — it's the best way to help other homeowners find us.</p>
                    @if (!string.IsNullOrWhiteSpace(Model.GoogleReviewsUrl))
                    {
                        <a href="@Model.GoogleReviewsUrl" target="_blank" rel="noopener" class="btn btn-primary btn-block py-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold">
                            <span>Read Reviews on Google</span>
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                    else
                    {
                        <p class="text-muted fs-12 mb-0">Our Google Business Profile is coming soon.</p>
                    }
                </div>
            </aside>

            <!-- Main Feed: Testimonials -->
            <main class="order-1 order-lg-2">
                <!-- Stat Overview -->
                <div class="stat-overview-row">
                    <div class="stat-overview-pill">
                        <span class="num-highlight">4.9</span>
                        <div>
                            <div class="d-flex text-warning">
                                <span class="material-symbols-outlined icon-fill fs-18">star</span>
                                <span class="material-symbols-outlined icon-fill fs-18">star</span>
                                <span class="material-symbols-outlined icon-fill fs-18">star</span>
                                <span class="material-symbols-outlined icon-fill fs-18">star</span>
                                <span class="material-symbols-outlined icon-fill fs-18">star</span>
                            </div>
                            <p class="text-muted mb-0 fs-12 fw-semibold">Global Satisfaction</p>
                        </div>
                    </div>
                    <div class="stat-overview-pill">
                        <span class="num-highlight">2.4k</span>
                        <div>
                            <p class="text-primary mb-0 fs-14 fw-bold">Verified Reviews</p>
                            <p class="text-muted mb-0 fs-11">Updated today</p>
                        </div>
                    </div>
                </div>

                <!-- Testimonial List -->
                <div class="review-feed">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <!-- Card -->
                            <article class="review-card">
                                <div class="review-author-row">
                                    <div class="review-author-info">
                                        <div class="review-avatar">
                                            @if (!string.IsNullOrEmpty(review.CustomerName) && review.CustomerName.Length >= 2)
                                            {
                                                <span>@review.CustomerName.Substring(0, 2).ToUpper()</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined">person</span>
                                            }
                                        </div>
                                        <div>
                                            <h3 class="font-headline-sm text-primary mb-0 fs-16 fw-bold">@review.CustomerName</h3>
                                            <p class="text-muted mb-0 fs-12">Client Review</p>
                                        </div>
                                    </div>
                                    <div class="text-warning d-flex">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <span class="material-symbols-outlined icon-fill fs-20">star</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined icon-unfill fs-20">star</span>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="font-body-md text-on-surface mb-3">
                                    "@review.Comment"
                                </p>
                                <div class="d-flex justify-content-end align-items-center">
                                    <small class="text-muted fs-11">@review.CreatedOn.ToString("dd MMM yyyy")</small>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 text-muted bg-light rounded-xl reviews-empty-state">
                            <span class="material-symbols-outlined text-muted mb-2 fs-36">rate_review</span>
                            <p class="mb-0">No reviews published yet. Be the first to share your experience!</p>
                        </div>
                    }
                </div>
            </main>
        </div>
    }
    else
    {
        <div class="text-center mt-12">
            <div class="glass-card rounded-xl p-5 mx-auto max-w-2xl">
                <span class="material-symbols-outlined text-secondary fs-36 mb-2">rate_review</span>
                <h2 class="font-headline-md text-primary mb-2">Loved our work?</h2>
                @if (!string.IsNullOrWhiteSpace(Model.GoogleReviewsUrl))
                {
                    <p class="text-muted mb-4">We're setting up our Google Business Profile so you can read (and leave) reviews there.</p>
                    <a href="@Model.GoogleReviewsUrl" target="_blank" rel="noopener" class="btn btn-primary btn-block py-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold max-w-xl mx-auto">
                        <span>Read Reviews on Google</span>
                        <span class="material-symbols-outlined">open_in_new</span>
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">We're setting up our Google Business Profile so you can read (and leave) reviews there — check back soon.</p>
                }
            </div>
        </div>
    }
</div>
