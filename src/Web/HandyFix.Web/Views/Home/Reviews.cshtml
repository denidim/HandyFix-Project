@model HandyFix.Web.ViewModels.Reviews.ReviewsListViewModel
@{
    this.ViewData["Title"] = "Customer Reviews";
    var hasReadLink = !string.IsNullOrWhiteSpace(Model.GoogleReviewsUrl);
    var hasLeaveLink = !string.IsNullOrWhiteSpace(Model.GoogleLeaveReviewUrl);
}

<div class="page-container services-page">
    <!-- Header & Breadcrumbs -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">Reviews</span>
        </nav>
        <div class="services-header-content text-center">
            <h1 class="services-hero-title">What Our <span>Clients Say.</span></h1>
            <p class="services-subtitle">
                Read what homeowners across Surrey and South London say about our work.
            </p>
        </div>
    </section>

    @* Our Google reviews, typed in word for word by the admin (PROJECT_STATE Section 3eh). With
       none yet, the page is the card with the two Google buttons alone. *@
    @if (Model.Reviews.Any())
    {
        <div class="reviews-container mt-12">
            <!-- Sidebar: Google Reviews CTA -->
            <aside class="order-2 order-lg-1">
                <div class="glass-card rounded-xl p-4 sticky-top reviews-sidebar-sticky text-center">
                    <span class="material-symbols-outlined text-secondary fs-36 mb-2">rate_review</span>
                    <h2 class="font-headline-md text-primary mb-2">Loved our work?</h2>
                    <p class="text-muted mb-4">These are our customers' own words from Google. Had us round recently? Your review helps other homeowners find us.</p>
                    @if (hasReadLink)
                    {
                        <a href="@Model.GoogleReviewsUrl" target="_blank" rel="noopener" class="btn btn-primary btn-block py-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold">
                            <span>Read Our Google Reviews</span>
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                    @if (hasLeaveLink)
                    {
                        <a href="@Model.GoogleLeaveReviewUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-block py-3 mt-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold">
                            <span>Leave a Google Review</span>
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                </div>
            </aside>

            <!-- Main Feed: Testimonials -->
            <main class="order-1 order-lg-2">
                <div class="review-feed">
                    @foreach (var review in Model.Reviews)
                    {
                        <partial name="_ReviewCard" model="review" />
                    }
                </div>
            </main>
        </div>
    }
    else
    {
        <div class="text-center mt-12">
            <!-- Less padding on phones, so each button's label fits on one line. -->
            <div class="glass-card rounded-xl p-4 p-md-5 mx-auto max-w-2xl">
                <span class="material-symbols-outlined text-secondary fs-36 mb-2">rate_review</span>
                <h2 class="font-headline-md text-primary mb-2">Loved our work?</h2>
                @if (hasReadLink || hasLeaveLink)
                {
                    <p class="text-muted mb-4">Read what our customers say on Google. Had us round recently? Your review helps other homeowners find us.</p>
                    @if (hasReadLink)
                    {
                        <a href="@Model.GoogleReviewsUrl" target="_blank" rel="noopener" class="btn btn-primary btn-block py-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold max-w-xl mx-auto">
                            <span>Read Our Google Reviews</span>
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                    @if (hasLeaveLink)
                    {
                        <a href="@Model.GoogleLeaveReviewUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-block py-3 mt-3 d-flex align-items-center justify-content-center gap-2 rounded-lg fs-16 fw-semibold max-w-xl mx-auto">
                            <span>Leave a Google Review</span>
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">We're setting up our Google Business Profile so you can read (and leave) reviews there. Check back soon.</p>
                }
            </div>
        </div>
    }
</div>
