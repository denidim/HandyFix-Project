@{
    this.ViewData["Title"] = "Frequently Asked Questions";
}

<div class="page-container services-page">
    <!-- Header & Breadcrumbs -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">FAQ</span>
        </nav>
        <div class="services-header-content text-center">
            <h1 class="services-hero-title">How can we <span>help?</span></h1>
            <p class="services-subtitle">
                Everything you need to know about our professional home maintenance services, booking process, and policies.
            </p>
        </div>
    </section>

    <!-- Main Content Canvas -->
    <div class="info-canvas">
    <!-- FAQ Categories & Accordion -->
    <div class="faq-list" id="generalFaq" data-accordion data-accordion-open-first>

        <!-- Category: Booking & Process -->
        <div class="d-flex flex-column gap-3">
            <h2 class="font-headline-sm text-secondary px-2 d-flex align-items-center gap-2 mb-0">
                <span class="material-symbols-outlined">event_available</span>
                <span>Booking &amp; Process</span>
            </h2>

            <div class="accordion-item glass-morphism rounded-xl overflow-hidden">
                <button class="w-100 px-4 py-3 d-flex justify-content-between align-items-center text-start bg-transparent border-0 accordion-toggle-btn" data-accordion-toggle>
                    <span class="font-headline-sm text-primary fs-16 fw-bold">How do I book a service?</span>
                    <span class="material-symbols-outlined arrow-icon transition-transform fs-20">expand_more</span>
                </button>
                <div class="accordion-content">
                    Press Book Now, pick the job you need and a time that suits you, and tell us what is wrong. A £@Deposit.Pounds deposit secures your slot. Once it is paid you get a confirmation email, and another one with your technician's name when one is assigned.
                </div>
            </div>

            <div class="accordion-item glass-morphism rounded-xl overflow-hidden">
                <button class="w-100 px-4 py-3 d-flex justify-content-between align-items-center text-start bg-transparent border-0 accordion-toggle-btn" data-accordion-toggle>
                    <span class="font-headline-sm text-primary fs-16 fw-bold">What is the £@Deposit.Pounds deposit for?</span>
                    <span class="material-symbols-outlined arrow-icon transition-transform fs-20">expand_more</span>
                </button>
                <div class="accordion-content">
                    The £@Deposit.Pounds deposit secures your appointment and ensures the professional's travel and time are covered. This amount is fully deductible from your final invoice. We use this system to maintain a reliable schedule for all our clients and professionals.
                </div>
            </div>

            <div class="accordion-item glass-morphism rounded-xl overflow-hidden">
                <button class="w-100 px-4 py-3 d-flex justify-content-between align-items-center text-start bg-transparent border-0 accordion-toggle-btn" data-accordion-toggle>
                    <span class="font-headline-sm text-primary fs-16 fw-bold">How is my time charged?</span>
                    <span class="material-symbols-outlined arrow-icon transition-transform fs-20">expand_more</span>
                </button>
                <div class="accordion-content">
                    <strong>Plumbing and Handyman</strong> jobs start with a one-hour minimum at the hourly rate for the service. After the first hour, additional time is billed in 30-minute blocks at the same hourly rate. <strong>Small Building &amp; Refurbishment</strong> work is quoted as a fixed price after a free on-site survey.
                </div>
            </div>
        </div>

        <!-- Category: Cancellations & Refunds -->
        <div class="d-flex flex-column gap-3 pt-4">
            <h2 class="font-headline-sm text-secondary px-2 d-flex align-items-center gap-2 mb-0">
                <span class="material-symbols-outlined">cancel</span>
                <span>Cancellations &amp; Refunds</span>
            </h2>

            <div class="accordion-item glass-morphism rounded-xl overflow-hidden">
                <button class="w-100 px-4 py-3 d-flex justify-content-between align-items-center text-start bg-transparent border-0 accordion-toggle-btn" data-accordion-toggle>
                    <span class="font-headline-sm text-primary fs-16 fw-bold">Can I cancel my booking?</span>
                    <span class="material-symbols-outlined arrow-icon transition-transform fs-20">expand_more</span>
                </button>
                <div class="accordion-content">
                    Yes. To cancel or reschedule, call or email us. Cancellations made more than 24 hours before the appointment get a full refund of the £@Deposit.Pounds deposit. Cancellations within 24 hours are non-refundable.
                </div>
            </div>
        </div>

        <!-- Category: Emergency Callouts -->
        <div class="d-flex flex-column gap-3 pt-4">
            <h2 class="font-headline-sm text-secondary px-2 d-flex align-items-center gap-2 mb-0">
                <span class="material-symbols-outlined">emergency</span>
                <span>Emergency Callouts</span>
            </h2>

            <div class="accordion-item glass-morphism rounded-xl overflow-hidden faq-emergency-highlight">
                <button class="w-100 px-4 py-3 d-flex justify-content-between align-items-center text-start bg-transparent border-0 accordion-toggle-btn" data-accordion-toggle>
                    <span class="font-headline-sm text-primary fs-16 fw-bold">Do you offer 24/7 emergency services?</span>
                    <span class="material-symbols-outlined arrow-icon transition-transform fs-20">expand_more</span>
                </button>
                <div class="accordion-content">
                    @* The rate comes from the emergency service, set in the admin panel (PROJECT_STATE Section 3eg). *@
                    Yes. We answer the phone 24/7, so call or WhatsApp us about a burst pipe, a flood or a leak you cannot stop, day or night, evenings and Sundays included. Emergency plumbing is charged at @this.ViewData["EmergencyRate"] (one-hour minimum) plus any parts required. There's no separate call-out fee. We aim to have a technician with you within 60 to 90 minutes. For anything that can wait, <a asp-controller="Booking" asp-action="Index">pick a time that suits you online</a>, Monday to Saturday, 9am to 5pm.
                </div>
            </div>
        </div>
    </div>

    <!-- Contact CTA Card -->
    @* Three buttons do not fit beside the text in this column, so the text sits above them at
       every width; the buttons share a row from tablet width up and stack on a phone. *@
    <section class="mt-5 glass-morphism p-4 rounded-xl d-flex flex-column align-items-center gap-4 faq-contact-cta">
        <div class="text-center">
            <h3 class="font-headline-md text-primary mb-1">Still have questions?</h3>
            <p class="text-on-surface-variant font-body-md mb-0">Send us an enquiry, message us on WhatsApp or give us a call and we'll help.</p>
        </div>
        <div class="d-flex flex-column flex-md-row gap-3">
            <a asp-controller="Home" asp-action="Contact" class="btn btn-outline d-flex align-items-center justify-content-center gap-2 px-4 py-3 rounded-lg fw-semibold text-nowrap info-print-btn">
                <span class="material-symbols-outlined">mail</span>
                <span>Send an Enquiry</span>
            </a>
            <a href="@GlobalConstants.BusinessWhatsAppUrl" target="_blank" rel="noopener" class="btn btn-outline d-flex align-items-center justify-content-center gap-2 px-4 py-3 rounded-lg fw-semibold text-nowrap info-print-btn">
                <partial name="_WhatsAppIcon" />
                <span>WhatsApp</span>
            </a>
            <a href="tel:@GlobalConstants.BusinessPhoneInternational" class="btn btn-primary d-flex align-items-center justify-content-center gap-2 px-4 py-3 rounded-lg fw-semibold text-nowrap">
                <span class="material-symbols-outlined">call</span>
                <span>Call Us</span>
            </a>
        </div>
    </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/accordion.js" asp-append-version="true"></script>
}
