@{
    this.ViewData["Title"] = "Cookie Policy";
}

<div class="page-container services-page">
    <!-- Header & Breadcrumbs -->
    <section class="services-header">
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
            <span class="breadcrumb-current">Cookie Policy</span>
        </nav>
        <div class="services-header-content text-center">
            <h1 class="services-hero-title">Cookie <span>Policy.</span></h1>
            <p class="font-label-sm text-on-surface-variant font-medium opacity-70 fs-14">Last updated: 23 September 2026</p>
        </div>
    </section>

    <!-- Content Canvas -->
    <div class="info-canvas">
        <div class="info-card">
            <section class="info-section">
                <div class="info-section-title-row">
                    <span class="material-symbols-filled text-secondary">cookie</span>
                    <h2>1. What are Cookies?</h2>
                </div>
                <p class="font-body-lg text-on-surface-variant leading-relaxed">
                    Cookies are small text files a website stores in your browser. We only use cookies the website needs to work. We don't use analytics, advertising or tracking cookies of any kind.
                </p>
            </section>

            <hr class="info-section-divider" />

            <section class="info-section">
                <div class="info-section-title-row">
                    <span class="material-symbols-filled text-secondary">checklist</span>
                    <h2>2. The Cookies We Set</h2>
                </div>
                <ul class="d-flex flex-column gap-2 p-0 list-unstyled">
                    <li class="d-flex align-items-start gap-3">
                        <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                        <span><strong>Cookie notice</strong> (<code>.AspNet.Consent</code>): remembers that you've seen and accepted our cookie notice, so it isn't shown again. Kept for one year.</span>
                    </li>
                    <li class="d-flex align-items-start gap-3">
                        <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                        <span><strong>Form security</strong> (<code>.AspNetCore.Antiforgery</code>): stops other websites from sending forms in your name. Deleted when you close your browser.</span>
                    </li>
                    <li class="d-flex align-items-start gap-3">
                        <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                        <span><strong>One-off messages</strong> (<code>.AspNetCore.Mvc.CookieTempDataProvider</code>): carries a short message, such as "thanks, we've received your enquiry", to the next page. Deleted as soon as it's been shown.</span>
                    </li>
                    <li class="d-flex align-items-start gap-3">
                        <span class="material-symbols-outlined text-success mt-1 fs-18">check_circle</span>
                        <span><strong>Staff sign-in</strong> (<code>.AspNetCore.Identity.Application</code>): only set for our own staff when they sign in to manage bookings. Customers never need an account.</span>
                    </li>
                </ul>
            </section>

            <hr class="info-section-divider" />

            <section class="info-section">
                <div class="info-section-title-row">
                    <span class="material-symbols-filled text-secondary">credit_card</span>
                    <h2>3. Stripe Checkout</h2>
                </div>
                <p class="font-body-lg text-on-surface-variant leading-relaxed">
                    When you pay your booking deposit, you're taken to Stripe's secure checkout page. Stripe sets its own cookies there to process the payment and prevent fraud; these are covered by <a href="https://stripe.com/cookies-policy/legal" target="_blank" rel="noopener">Stripe's cookie policy</a>.
                </p>
            </section>

            <hr class="info-section-divider" />

            <section class="info-section">
                <div class="info-section-title-row">
                    <span class="material-symbols-filled text-secondary">tune</span>
                    <h2>4. Managing Cookies</h2>
                </div>
                <p class="font-body-lg text-on-surface-variant leading-relaxed">
                    You can block or delete cookies in your browser settings. Because ours are all essential, blocking them may stop our booking and contact forms from working. How we handle your personal data is explained in our <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
                </p>
            </section>
        </div>
    </div>
</div>
