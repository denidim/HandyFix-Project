@using HandyFix.Data.Models
@model IEnumerable<HandyFix.Web.ViewModels.ServiceAreas.ServiceAreaViewModel>
@{
    // Schematic coverage diagram, not a geographic map.
    //
    // Each town sits at its true compass bearing from the Chessington base, at a
    // radius proportional to its real DriveTimeMinutes - so both axes carry real
    // meaning and nothing here is invented. The bearing, the side the name goes on
    // and a shorter name are stored on each area (PROJECT_STATE.md Section 3dm). An
    // area with no bearing is left off the diagram (it still appears in the mobile
    // list and the cards further down the page), so adding an area never breaks it.
    const int Cx = 450;
    const int Cy = 355;
    const double MinuteRadius = 11.0;

    // A town further than this is drawn just outside the outer ring, not past the
    // edge of the picture: the right-hand side has only 330px from the centre.
    const int MaxPlottedMinutes = 27;

    var hub = Model.FirstOrDefault(a => a.Slug == "chessington");
    var plotted = Model
        .Where(a => a.DiagramBearing.HasValue && a.Slug != "chessington")
        .Select(a =>
        {
            var bearing = a.DiagramBearing.Value;
            var radians = bearing * Math.PI / 180.0;
            var radius = Math.Min(a.DriveTimeMinutes, MaxPlottedMinutes) * MinuteRadius;

            // No side chosen: east half to the right, west half to the left.
            var side = a.DiagramLabelSide ?? (bearing < 180 ? DiagramLabelSide.Right : DiagramLabelSide.Left);
            var (anchor, dx, dy) = side switch
            {
                DiagramLabelSide.Left => ("end", -13, 5),
                DiagramLabelSide.Above => ("middle", 0, -16),
                DiagramLabelSide.Below => ("middle", 0, 26),
                _ => ("start", 13, 5),
            };

            return new
            {
                Area = a,
                Label = string.IsNullOrWhiteSpace(a.DiagramLabel) ? a.Name : a.DiagramLabel,
                Anchor = anchor,
                Dx = dx,
                Dy = dy,
                X = Cx + (radius * Math.Sin(radians)),
                Y = Cy - (radius * Math.Cos(radians)),
            };
        })
        .OrderBy(p => p.Area.DriveTimeMinutes)
        .ToList();

    // Mobile falls back to grouped pills - a 780px-wide diagram is unreadable on a phone.
    var bands = new (string Label, Func<int, bool> Match)[]
    {
        ("Under 10 minutes", m => m <= 10),
        ("10 to 20 minutes", m => m > 10 && m <= 20),
        ("20 to 25 minutes", m => m > 20),
    };
}

<figure class="coverage-map">
    <svg class="coverage-map-svg"
         viewBox="0 0 780 740"
         xmlns="http://www.w3.org/2000/svg"
         aria-labelledby="coverageMapTitle coverageMapDesc">
        <title id="coverageMapTitle">Coverage diagram for our service areas</title>
        <desc id="coverageMapDesc">
            A schematic showing @Model.Count() towns arranged by direction and driving time from our Chessington base. Each town links to its own page.
        </desc>

        @* Drive-time rings. *@
        @foreach (var minutes in new[] { 10, 20, 25 })
        {
            <circle class="coverage-ring" cx="@Cx" cy="@Cy" r="@(minutes * MinuteRadius)" />
        }

        @* Ring labels sit on their own ring in the empty western sector. The three bearings are
           staggered because the 20 and 25 minute rings are only 55px apart - at a shared bearing
           their pills collide. Verified by rendering, not by eye. *@
        @foreach (var (minutes, bearing) in new[] { (10, 270.0), (20, 262.0), (25, 278.0) })
        {
            var ringRadians = bearing * Math.PI / 180.0;
            var lx = Cx + ((minutes * MinuteRadius) * Math.Sin(ringRadians));
            var ly = Cy - ((minutes * MinuteRadius) * Math.Cos(ringRadians));
            <g class="coverage-ring-label">
                <rect x="@((lx - 26).ToString("F1"))" y="@((ly - 10).ToString("F1"))" width="52" height="19" rx="9" />
                <text x="@lx.ToString("F1")" y="@((ly + 4).ToString("F1"))" text-anchor="middle">@minutes min</text>
            </g>
        }

        @* Legend, tucked into the empty north-west corner outside the outer ring. *@
        <g class="coverage-legend">
            <circle class="coverage-dot coverage-dot-solid" cx="40" cy="64" r="6" />
            <text class="coverage-legend-text" x="56" y="69">Featured area</text>
            <circle class="coverage-dot" cx="40" cy="94" r="6" />
            <text class="coverage-legend-text" x="56" y="99">Also covered</text>
        </g>

        @* Spokes from the hub. *@
        @foreach (var p in plotted)
        {
            <line class="coverage-spoke" x1="@Cx" y1="@Cy" x2="@p.X.ToString("F1")" y2="@p.Y.ToString("F1")" />
        }

        @* Outer towns. *@
        @foreach (var p in plotted)
        {
            <a class="coverage-node @(p.Area.IsFeatured ? "is-featured" : string.Empty)"
               href="@Url.RouteUrl("AreaDetails", new { areaSlug = p.Area.Slug })"
               aria-label="@p.Area.Name, about @p.Area.DriveTimeMinutes minutes from our Chessington base">
                <circle class="coverage-hit" cx="@p.X.ToString("F1")" cy="@p.Y.ToString("F1")" r="26" />
                <circle class="coverage-dot" cx="@p.X.ToString("F1")" cy="@p.Y.ToString("F1")" r="6" />
                <text class="coverage-label"
                      x="@((p.X + p.Dx).ToString("F1"))"
                      y="@((p.Y + p.Dy).ToString("F1"))"
                      text-anchor="@p.Anchor">@p.Label</text>
            </a>
        }

        @* The Chessington hub, drawn last so it sits above the spokes. *@
        @if (hub != null)
        {
            <a class="coverage-node coverage-node-hub"
               href="@Url.RouteUrl("AreaDetails", new { areaSlug = hub.Slug })"
               aria-label="@hub.Name, our base">
                <circle class="coverage-hub-halo" cx="@Cx" cy="@Cy" r="16" />
                <circle class="coverage-hub" cx="@Cx" cy="@Cy" r="9" />
                <text class="coverage-label coverage-label-hub" x="@Cx" y="@(Cy + 31)" text-anchor="middle">@hub.Name</text>
                <text class="coverage-hub-sub" x="@Cx" y="@(Cy + 43)" text-anchor="middle">Our base</text>
            </a>
        }
    </svg>

    @* Phone layout: the diagram's labels are far too small to read below ~768px. *@
    <div class="coverage-list">
        @foreach (var band in bands)
        {
            var inBand = Model.Where(a => band.Match(a.DriveTimeMinutes)).OrderBy(a => a.DriveTimeMinutes).ToList();
            if (inBand.Count == 0)
            {
                continue;
            }

            <div class="coverage-list-band">
                <h3 class="coverage-list-heading">@band.Label</h3>
                <ul class="coverage-list-items">
                    @foreach (var area in inBand)
                    {
                        <li>
                            <a class="coverage-pill @(area.IsFeatured ? "is-featured" : string.Empty)"
                               asp-route="AreaDetails"
                               asp-route-areaSlug="@area.Slug">@area.Name</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <figcaption class="coverage-caption">
        Approximate driving times from our Chessington base. Directions and distances are indicative. This is a coverage diagram, not a street map. Select any town for local details.
    </figcaption>
</figure>
