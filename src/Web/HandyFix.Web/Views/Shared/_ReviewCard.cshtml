@model HandyFix.Web.ViewModels.Reviews.ReviewViewModel
@* One of our Google reviews as plain text, on /Reviews and on its town's page (PROJECT_STATE
   Section 3eh). The stars are pictures for people only: no review data for search engines goes
   with it, since Google ignores or penalises stars a business shows about itself. *@
<article class="review-card">
    <div class="review-author-row">
        <div class="review-author-info">
            <div class="review-avatar">
                @if (!string.IsNullOrEmpty(Model.Initials))
                {
                    <span>@Model.Initials</span>
                }
                else
                {
                    <span class="material-symbols-outlined">person</span>
                }
            </div>
            <div>
                <h3 class="font-headline-sm text-primary mb-0 fs-16 fw-bold">@Model.CustomerName</h3>
                @if (Model.TownAndJob != null)
                {
                    <p class="text-muted mb-0 fs-14">@Model.TownAndJob</p>
                }
            </div>
        </div>
        <div class="text-warning d-flex" role="img" aria-label="@Model.Rating out of 5 stars">
            @for (int i = 1; i <= 5; i++)
            {
                <span class="@(i <= Model.Rating ? "material-symbols-filled" : "material-symbols-outlined") fs-20" aria-hidden="true">star</span>
            }
        </div>
    </div>
    <p class="font-body-md text-on-surface mb-3 pre-wrap">"@Model.Comment"</p>
    <div class="d-flex justify-content-end align-items-center">
        <small class="text-muted fs-14">Google review, @Model.GoogleMonth</small>
    </div>
</article>
