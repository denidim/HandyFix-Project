@using HandyFix.Common
@model string
@*
    The site logo: the shield emblem with the name beside it, drawn as inline SVG from the
    mature_three_trades_logo artwork (PROJECT_STATE Section 3bq). Inline rather than an <img>
    so a placement can recolour it from CSS: the logo-* classes below are what logo.css targets
    to turn the navy white on the dark footer. The model is an id prefix, because the header
    and footer both render this on one page and the gradient/mask ids must stay unique.
*@
@{
    string p = this.Model;
}
<svg class="site-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1560 556" role="img" aria-label="@GlobalConstants.SystemName">
    <defs>
        <linearGradient id="@(p)-teal" gradientUnits="userSpaceOnUse" x1="0" y1="157" x2="0" y2="390">
            <stop class="logo-teal-top" offset="0" stop-color="#14697e" />
            <stop class="logo-teal-bottom" offset="1" stop-color="#0c4862" />
        </linearGradient>
        <linearGradient id="@(p)-copper" gradientUnits="userSpaceOnUse" x1="0" y1="-66" x2="0" y2="321">
            <stop offset="0" stop-color="#8f3f15" />
            <stop offset="0.6" stop-color="#cf7c3e" />
            <stop offset="1" stop-color="#a65220" />
        </linearGradient>
        @* The icons sit over the shield with a clear gap around them. *@
        <mask id="@(p)-shield-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
            <rect width="1024" height="1024" fill="#fff" />
            <g fill="#000" stroke="#000" stroke-linejoin="round">
                <path d="M512 157 C500 215 440 262 440 318 A72 72 0 0 0 584 318 C584 262 524 215 512 157 Z" stroke-width="33" />
                <path d="M-54.8 -36.8 A66 66 0 0 0 -25 61.1 L-25 296 A25 25 0 0 0 25 296 L25 61.1 A66 66 0 0 0 -9.0 -65.4 L12.3 -31.3 L9.1 -8.1 L-11.2 4.7 L-33.5 -2.7 Z" transform="translate(334 396) rotate(-45) scale(1.05)" stroke-width="31" />
                <path d="M400 572 L610 362 L744 496 L702 496 L610 404 L424 590 Z" stroke="none" />
                <path d="M400 572 L610 362 L744 496 L702 496 L610 404 L424 590" fill="none" stroke-linejoin="miter" stroke-width="32" />
                <path d="M676 428 L676 382 L712 382 L712 464 Z" stroke-linejoin="miter" stroke-width="32" />
            </g>
        </mask>
        @* The roof passes under the wrench. *@
        <mask id="@(p)-roof-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
            <rect width="1024" height="1024" fill="#fff" />
            <path d="M-54.8 -36.8 A66 66 0 0 0 -25 61.1 L-25 296 A25 25 0 0 0 25 296 L25 61.1 A66 66 0 0 0 -9.0 -65.4 L12.3 -31.3 L9.1 -8.1 L-11.2 4.7 L-33.5 -2.7 Z" transform="translate(334 396) rotate(-45) scale(1.05)" fill="#000" stroke="#000" stroke-width="31" />
        </mask>
    </defs>

    @* Drawn in the artwork's 1024x1024 coordinates, shifted so the emblem starts at the left edge. *@
    <g transform="translate(-258 -147)">
        @* Shield *@
        <g class="logo-ink" mask="url(#@(p)-shield-cut)" fill="none" stroke="#13284b" stroke-width="12" stroke-linejoin="miter">
            <path d="M308 247 L512 189 L716 247 L716 500 C716 592 626 652 512 694 C398 652 308 592 308 500 Z" />
            <path d="M345 283 L512 236 L679 283 L679 498 C679 570 604 622 512 656 C420 622 345 570 345 498 Z" />
        </g>

        @* Building: roof and chimney *@
        <g class="logo-gold" mask="url(#@(p)-roof-cut)" fill="none" stroke="#b8975a" stroke-width="14" stroke-linejoin="miter">
            <path d="M400 572 L610 362 L744 496 L702 496 L610 404 L424 590" />
            <path d="M676 428 L676 382 L712 382 L712 464" />
        </g>

        @* Handyman: wrench, drawn pointing up around its head and turned 45 degrees *@
        <g transform="translate(334 396) rotate(-45) scale(1.05)" fill="none" stroke="url(#@(p)-copper)" stroke-linejoin="round">
            <path d="M-54.8 -36.8 A66 66 0 0 0 -25 61.1 L-25 296 A25 25 0 0 0 25 296 L25 61.1 A66 66 0 0 0 -9.0 -65.4 L12.3 -31.3 L9.1 -8.1 L-11.2 4.7 L-33.5 -2.7 Z" stroke-width="13" />
            <rect x="-14" y="20" width="28" height="36" rx="4" stroke-width="6" />
            <path d="M-14 32 H14 M-14 44 H14" stroke-width="5" />
            <rect x="-7" y="106" width="14" height="170" rx="7" stroke-width="6" />
        </g>

        @* Plumbing: water drop *@
        <g stroke="url(#@(p)-teal)" stroke-linejoin="round">
            <path d="M512 157 C500 215 440 262 440 318 A72 72 0 0 0 584 318 C584 262 524 215 512 157 Z" fill="none" stroke-width="15" />
            <path d="M512 243 C506 272 478 296 478 322 A34 34 0 0 0 546 322 C546 296 518 272 512 243 Z" fill="none" stroke-width="8" />
            <path d="M512 243 C518 272 546 296 546 322 A34 34 0 0 1 512 356 Z" fill="url(#@(p)-teal)" stroke-width="8" />
        </g>

        @* Words: real text, so they stay sharp. textLength pins each word's width whatever serif a device has. *@
        <g class="logo-ink-text" font-family="Georgia, 'Times New Roman', serif" font-weight="700" fill="#13284b">
            <text x="800" y="330" font-size="158" textLength="1005" lengthAdjust="spacing">PLUMBING</text>
            <text x="800" y="495" font-size="150" textLength="1005" lengthAdjust="spacing">HANDYMAN</text>
            <text x="1302.5" y="625" font-size="100" text-anchor="middle" textLength="560" lengthAdjust="spacing">SURREY</text>
        </g>
        <path class="logo-gold" d="M800 590 H988 M1617 590 H1805" stroke="#b8975a" stroke-width="9" />
    </g>
</svg>
