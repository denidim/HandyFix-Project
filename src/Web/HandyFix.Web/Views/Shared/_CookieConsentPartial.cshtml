@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = this.Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent" class="alert alert-info alert-dismissible fade show" role="alert">
        We only use essential cookies that make this site work, such as keeping forms secure. No tracking or analytics. <a asp-area="" asp-controller="Home" asp-action="CookiePolicy">Read our Cookie Policy</a>.
        <button type="button" class="btn btn-primary accept-policy close" data-bs-dismiss="alert" data-cookie-string="@cookieString">
            Accept
        </button>
    </div>
    <script>
        (function () {
            var banner = document.getElementById("cookieConsent");
            var button = banner.querySelector("button[data-cookie-string]");
            button.addEventListener("click", function () {
                document.cookie = button.dataset.cookieString;
                banner.remove();
            }, false);
        })();
    </script>
}
