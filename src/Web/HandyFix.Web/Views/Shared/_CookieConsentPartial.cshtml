@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = this.Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    @* One slim line at the bottom of the screen (css/components/cookie-notice.css). site.js stores
       the consent cookie from the button's data-cookie-string and takes the line away. *@
    <div id="cookieConsent" role="alert">
        <span>We only use essential cookies. <a asp-area="" asp-controller="Home" asp-action="CookiePolicy">Cookie policy</a></span>
        <button type="button" class="cookie-notice-ok" data-cookie-string="@cookieString">OK</button>
    </div>
}
