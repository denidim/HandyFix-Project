@using HandyFix.Common
<footer class="footer-main">
    <div class="page-container footer-content">
        <div>
            <a class="site-logo mb-6" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_Logo" model="@("footer")" /></a>
            <p class="text-white-80 font-body-md leading-relaxed mb-6">
                Your trusted local partner for plumbing, maintenance, and handyman services across Surrey and South London. Dedicated to quality and transparency.
            </p>
            <p class="mb-6">
                <a class="footer-link" href="mailto:@GlobalConstants.BusinessEmail">@GlobalConstants.BusinessEmail</a>
            </p>
            <div class="footer-social">
                <a class="footer-social-icon" href="mailto:@GlobalConstants.BusinessEmail" aria-label="Email us">
                    <span class="material-symbols-outlined">mail</span>
                </a>
                <a class="footer-social-icon" href="tel:@GlobalConstants.BusinessPhoneInternational" aria-label="Call us">
                    <span class="material-symbols-outlined">phone</span>
                </a>
                <a class="footer-social-icon" href="@GlobalConstants.BusinessWhatsAppUrl" target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg>
                </a>
            </div>
        </div>
        <div class="footer-column">
            <h5 class="footer-title">Quick Links</h5>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Terms">Terms of Service</a>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="FAQ">FAQ</a>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="JoinTeam">Join Our Team</a>
            <a class="footer-link" asp-area="" asp-controller="Services" asp-action="Index">Services</a>
            <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Reviews">Reviews</a>
        </div>
        <div>
            <h5 class="footer-title">Service Areas</h5>
            <vc:footer-service-areas></vc:footer-service-areas>
            <div class="footer-copyright">
                <p>© @DateTime.Now.Year @GlobalConstants.SystemName. All rights reserved.</p>
                <p>@GlobalConstants.SystemName is a trading name of @GlobalConstants.CompanyLegalName, registered in England and Wales, company number @GlobalConstants.CompanyNumber. Registered office: @GlobalConstants.CompanyAddress.</p>
            </div>
        </div>
    </div>
</footer>
