@using HandyFix.Common
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions
@{
    // The picture a chat or social app shows beside a link to this page. An area page names its
    // own town's picture; every other page gets the site's, made by
    // tools/image-gen/make-share-picture.mjs (PROJECT_STATE Section 3da). Its address carries a
    // version, so an app that keeps link pictures fetches a changed one afresh.
    var sharePicture = this.ViewData["OgImage"] as string;
    var isSitePicture = sharePicture == null;
    if (isSitePicture)
    {
        sharePicture = $"{this.Context.Request.Scheme}://{this.Context.Request.Host}{this.FileVersions.AddFileVersionToPath(this.Context.Request.PathBase, "/images/share.jpg")}";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    @if (this.ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@this.ViewData["MetaDescription"]" />
    }
    @if (this.ViewData["Canonical"] != null)
    {
        <link rel="canonical" href="@this.ViewData["Canonical"]" />
    }
    <title>@EnvironmentMark.TitlePrefix(HostEnvironment)@this.ViewData["Title"] - @GlobalConstants.SystemName</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@GlobalConstants.SystemName" />
    <meta property="og:title" content="@this.ViewData["Title"] - @GlobalConstants.SystemName" />
    @if (this.ViewData["MetaDescription"] != null)
    {
        <meta property="og:description" content="@this.ViewData["MetaDescription"]" />
    }
    @if (this.ViewData["Canonical"] != null)
    {
        <meta property="og:url" content="@this.ViewData["Canonical"]" />
    }
    <meta property="og:image" content="@sharePicture" />
    @if (isSitePicture)
    {
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <partial name="_WebFonts" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.min.css" />
</head>
<body class="@this.ViewData["BodyClass"]">
    <partial name="_EnvironmentStrip" />
    <partial name="_Navbar" />
    
    <partial name="_CookieConsentPartial" />
    <main role="main">
        @this.RenderBody()
    </main>

    <!-- Sticky Mobile CTA Navigation Bar -->
    <partial name="_MobileStickyCta" />
    
    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await this.RenderSectionAsync("Scripts", required: false)
</body>
</html>
