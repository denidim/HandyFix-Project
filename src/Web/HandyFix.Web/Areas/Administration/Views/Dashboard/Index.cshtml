@model HandyFix.Web.ViewModels.Administration.Dashboard.IndexViewModel
@using HandyFix.Common
@using HandyFix.Web.ViewModels.Administration.Dashboard
@{
    this.ViewData["Title"] = "Dashboard Overview";

    // The business's day, not the server's: the server keeps UTC.
    var today = UkTime.FromUtc(DateTime.UtcNow);
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <div>
        <h1 class="admin-page-title">Administration Dashboard</h1>
        <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Where the jobs, the money and the enquiries stand.</p>
    </div>
    <span class="d-none d-md-inline font-label-sm font-bold text-on-surface">@today.ToString("dddd, dd MMM")</span>
</div>

@* An email the site could not send in the last week, each with the job or enquiry it was about.
   Shown only when there is one. Until PROJECT_STATE.md Section 3cq a failed email was a line in
   the server's log: nobody knew to tell a customer another way, or that a notice never came. *@
@{
    var emailsNotSent = Model.EmailsNotSent.ToList();
}
@if (emailsNotSent.Count > 0)
{
    <section class="alert alert-warning mb-5" id="emails-not-sent" aria-labelledby="emails-not-sent-title">
        <h2 class="font-headline-sm mb-2" id="emails-not-sent-title">
            @(emailsNotSent.Count == 1 ? "1 email" : $"{emailsNotSent.Count} emails") did not go out in the last @IndexViewModel.EmailsNotSentDays days
        </h2>
        <p class="mb-3">Open each one. If the email was for a customer, contact them another way.</p>
        <ul class="mb-0 ps-3">
            @foreach (var email in emailsNotSent)
            {
                <li class="mb-1">
                    <span class="font-bold">@UkTime.FromUtc(email.CreatedOn).ToString("ddd d MMM, HH:mm")</span>
                    &middot; @email.What &middot;
                    @if (email.BookingId.HasValue)
                    {
                        <a class="alert-link" asp-area="Administration" asp-controller="Bookings" asp-action="Details" asp-route-id="@email.BookingId">Job #@BookingReference.Short(email.BookingId.Value), @NameFormat.Full(email.CustomerFirstName, email.CustomerLastName)</a>
                    }
                    else if (email.InquiryId.HasValue)
                    {
                        <a class="alert-link" asp-area="Administration" asp-controller="Enquiries" asp-action="Details" asp-route-id="@email.InquiryId">Enquiry from @email.InquiryName</a>
                    }
                </li>
            }
        </ul>
    </section>
}

<!-- Every figure here is counted from the database, and every card opens the list it counts.
     Nothing on this page is fixed text standing in for a figure (PROJECT_STATE.md Section 3ch). -->
<div class="bento-grid bento-grid-4" id="dashboard-figures">
    <!-- Money that has come in and stayed: website deposits and payments written on jobs -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">payments</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Revenue</p>
            <h2 class="dashboard-stat-card-value">£@Model.TotalRevenue.ToString("N2")</h2>
        </div>
    </a>

    <!-- Jobs -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header gap-2">
            <div class="dashboard-stat-card-icon-wrapper tint-black-soft">
                <span class="material-symbols-outlined text-primary">calendar_today</span>
            </div>
            @if (Model.PendingBookingsCount > 0)
            {
                <span class="font-label-sm font-bold px-2 py-1 rounded tint-waiting">@Model.PendingBookingsCount waiting for deposit</span>
            }
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Jobs</p>
            <h2 class="dashboard-stat-card-value">@Model.TotalBookingsCount</h2>
        </div>
    </a>

    <!-- The admin's to-do: the same figure as the card on the Jobs page -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">engineering</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Waiting for a Technician</p>
            <h2 class="dashboard-stat-card-value">@Model.AwaitingTechnicianCount</h2>
        </div>
    </a>

    <!-- Enquiries -->
    <a asp-area="Administration" asp-controller="Enquiries" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">chat_bubble</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Enquiries</p>
            <h2 class="dashboard-stat-card-value">@Model.TotalEnquiriesCount</h2>
        </div>
    </a>
</div>

<h3 class="font-headline-sm text-primary mb-4 d-flex align-items-center gap-2">
    <span class="material-symbols-outlined">bolt</span>
    <span>Quick Actions</span>
</h3>

<div class="quick-actions-grid" id="dashboard-actions">
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Create" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">add</span>
        </div>
        <span class="font-button-text text-primary">Write a Job In</span>
    </a>
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">event_note</span>
        </div>
        <span class="font-button-text text-primary">Jobs</span>
    </a>
    <a asp-area="Administration" asp-controller="Calendar" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">schedule</span>
        </div>
        <span class="font-button-text text-primary">Manage Availability</span>
    </a>
    <a asp-area="Administration" asp-controller="Enquiries" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">forum</span>
        </div>
        <span class="font-button-text text-primary">Client Enquiries</span>
    </a>
    <a asp-area="Administration" asp-controller="Services" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">construction</span>
        </div>
        <span class="font-button-text text-primary">Manage Services</span>
    </a>
</div>
