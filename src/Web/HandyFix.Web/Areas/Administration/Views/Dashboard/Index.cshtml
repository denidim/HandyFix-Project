@model HandyFix.Web.ViewModels.Administration.Dashboard.IndexViewModel
@using HandyFix.Common
@using HandyFix.Web.ViewModels.Administration.Dashboard
@{
    this.ViewData["Title"] = "Dashboard Overview";

    // The business's day, not the server's: the server keeps UTC.
    var today = UkTime.FromUtc(DateTime.UtcNow);
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <div>
        <h1 class="admin-page-title">Administration Dashboard</h1>
        <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Where the jobs, the money and the enquiries stand.</p>
    </div>
    <span class="d-none d-md-inline font-label-sm font-bold text-on-surface">@today.ToString("dddd, dd MMM")</span>
</div>

@* An email the site could not send in the last week, each with the job or enquiry it was about.
   Shown only when there is one. Until PROJECT_STATE.md Section 3cq a failed email was a line in
   the server's log: nobody knew to tell a customer another way, or that a notice never came. *@
@{
    var emailsNotSent = Model.EmailsNotSent.ToList();
}
@if (emailsNotSent.Count > 0)
{
    <section class="alert alert-warning mb-5" id="emails-not-sent" aria-labelledby="emails-not-sent-title">
        <h2 class="font-headline-sm mb-2" id="emails-not-sent-title">
            @(emailsNotSent.Count == 1 ? "1 email" : $"{emailsNotSent.Count} emails") did not go out in the last @IndexViewModel.EmailsNotSentDays days
        </h2>
        <p class="mb-3">Open each one. If the email was for a customer, contact them another way.</p>
        <ul class="mb-0 ps-3">
            @foreach (var email in emailsNotSent)
            {
                <li class="mb-1">
                    <span class="font-bold">@UkTime.FromUtc(email.CreatedOn).ToString("ddd d MMM, HH:mm")</span>
                    &middot; @email.What &middot;
                    @if (email.BookingId.HasValue)
                    {
                        <a class="alert-link" asp-area="Administration" asp-controller="Bookings" asp-action="Details" asp-route-id="@email.BookingId">Job #@BookingReference.Short(email.BookingId.Value), @NameFormat.Full(email.CustomerFirstName, email.CustomerLastName)</a>
                    }
                    else if (email.InquiryId.HasValue)
                    {
                        <a class="alert-link" asp-area="Administration" asp-controller="Enquiries" asp-action="Details" asp-route-id="@email.InquiryId">Enquiry from @email.InquiryName</a>
                    }
                </li>
            }
        </ul>
    </section>
}

<!-- Every figure here is counted from the database, and every card opens the list it counts.
     Nothing on this page is fixed text standing in for a figure (PROJECT_STATE.md Section 3ch). -->
<div class="bento-grid bento-grid-4" id="dashboard-figures">
    <!-- Money that has come in and stayed: website deposits and payments written on jobs -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">payments</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Revenue</p>
            <h2 class="dashboard-stat-card-value">£@Model.TotalRevenue.ToString("N2")</h2>
        </div>
    </a>

    <!-- Jobs -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header gap-2">
            <div class="dashboard-stat-card-icon-wrapper tint-black-soft">
                <span class="material-symbols-outlined text-primary">calendar_today</span>
            </div>
            @if (Model.PendingBookingsCount > 0)
            {
                <span class="font-label-sm font-bold px-2 py-1 rounded tint-waiting">@Model.PendingBookingsCount waiting for deposit</span>
            }
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Jobs</p>
            <h2 class="dashboard-stat-card-value">@Model.TotalBookingsCount</h2>
        </div>
    </a>

    <!-- The admin's to-do: the same figure as the card on the Jobs page -->
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">engineering</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Waiting for a Technician</p>
            <h2 class="dashboard-stat-card-value">@Model.AwaitingTechnicianCount</h2>
        </div>
    </a>

    <!-- Enquiries -->
    <a asp-area="Administration" asp-controller="Enquiries" asp-action="Index" class="dashboard-stat-card text-no-decoration">
        <div class="dashboard-stat-card-header">
            <div class="dashboard-stat-card-icon-wrapper tint-secondary">
                <span class="material-symbols-outlined text-secondary">chat_bubble</span>
            </div>
        </div>
        <div>
            <p class="dashboard-stat-card-label">Total Enquiries</p>
            <h2 class="dashboard-stat-card-value">@Model.TotalEnquiriesCount</h2>
        </div>
    </a>
</div>

<h3 class="font-headline-sm text-primary mb-4 d-flex align-items-center gap-2">
    <span class="material-symbols-outlined">bolt</span>
    <span>Quick Actions</span>
</h3>

<div class="quick-actions-grid mb-5" id="dashboard-actions">
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Create" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">add</span>
        </div>
        <span class="font-button-text text-primary">Write a Job In</span>
    </a>
    <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">event_note</span>
        </div>
        <span class="font-button-text text-primary">Jobs</span>
    </a>
    <a asp-area="Administration" asp-controller="Calendar" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">schedule</span>
        </div>
        <span class="font-button-text text-primary">Manage Availability</span>
    </a>
    <a asp-area="Administration" asp-controller="Enquiries" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">forum</span>
        </div>
        <span class="font-button-text text-primary">Client Enquiries</span>
    </a>
    <a asp-area="Administration" asp-controller="Services" asp-action="Index" class="action-btn-card">
        <div class="action-btn-circle">
            <span class="material-symbols-outlined">construction</span>
        </div>
        <span class="font-button-text text-primary">Manage Services</span>
    </a>
</div>

<!-- What visitors did on the website: the sums the pages' script sends in, and beside them the
     bookings, deposits and enquiries kept in the panel (PROJECT_STATE.md Section 3fa). The site
     has no analytics service, so this table is how "nobody comes" is told from "they come and do
     not book". It keeps sums only, nothing about any one visitor. -->
@{
    var counts = Model.SiteCounts;
}
<section class="glass-card p-4 rounded-xl admin-card mb-5" id="dashboard-site-counts">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-1">
        <h3 class="font-headline-sm text-primary mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">groups</span>
            <span>What Visitors Did on the Website</span>
        </h3>
        <form method="get" asp-area="Administration" asp-controller="Dashboard" asp-action="Index" asp-fragment="dashboard-site-counts" class="m-0">
            @* The other table keeps its own choice when this one is changed. *@
            @if (Model.HeardAboutIsAllTime)
            {
                <input type="hidden" name="heardAbout" value="@IndexViewModel.HeardAboutAllTime" />
            }
            <select name="counts" class="admin-status-filter font-body-md" data-submit-on-change aria-label="Count what visitors did in">
                <option value="">Last @IndexViewModel.SiteCountsDays days</option>
                <option value="@IndexViewModel.SiteCountsAllTime" selected="@counts.IsAllTime">Since the count began</option>
            </select>
        </form>
    </div>
    <p class="font-label-sm text-on-surface-variant mb-3">
        What happened on the website @(counts.IsAllTime ? "since the count began" : "in the last " + IndexViewModel.SiteCountsDays + " days"). A visit is someone arriving from outside the site who then scrolls or taps: the same person coming twice is two visits, and our own browsers are left out. The bookings, deposits and enquiries are the ones kept in this panel.
        @if (counts.CountingSince.HasValue)
        {
            <text>The count began on @counts.CountingSince.Value.ToString("d MMM yyyy"): nothing before then is in this table.</text>
        }
        else
        {
            <text>Nothing has been counted yet.</text>
        }
    </p>
    <table class="table mb-0 dashboard-heard-about-table">
        <thead>
            <tr>
                <th scope="col" class="font-label-sm text-on-surface-variant">What happened</th>
                <th scope="col" class="font-label-sm text-on-surface-variant text-end">Times</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="font-body-md text-on-surface">
                    Visits to the site
                    <span class="d-block font-label-sm text-on-surface-variant">@counts.VisitsOnPhone on a phone, @counts.VisitsOnComputer on a computer</span>
                </td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="visits">@counts.Visits</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Opened the booking page</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="booking-opened">@counts.BookingOpened</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Picked a time</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="time-picked">@counts.TimePicked</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Sent the booking</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="bookings-sent">@counts.BookingsSent</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Paid the deposit</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="deposits-paid">@counts.DepositsPaid</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Tapped Call</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="call-tapped">@counts.CallTapped</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Tapped WhatsApp</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="whatsapp-tapped">@counts.WhatsAppTapped</td>
            </tr>
            <tr>
                <td class="font-body-md text-on-surface">Sent an enquiry</td>
                <td class="font-body-md text-primary text-end fw-bold" data-count="enquiries-sent">@counts.EnquiriesSent</td>
            </tr>
        </tbody>
    </table>

    @* A browser that has opened this panel is one of ours, and its looks at the public site are
       left out of the table (AdministrationController). The button puts it back, or out again. *@
    <form method="post" asp-area="Administration" asp-controller="Dashboard" asp-action="CountThisBrowser" class="d-flex align-items-center flex-wrap gap-3 mt-4" id="dashboard-count-this-browser">
        <input type="hidden" name="count" value="@(counts.ThisBrowserIsCounted ? "false" : "true")" />
        <span class="font-label-sm text-on-surface-variant">
            @(counts.ThisBrowserIsCounted
                ? "This browser is counted like any visitor's when it looks at the site signed out."
                : "This browser is not counted: it has opened this panel, so its looks at the site are ours.")
        </span>
        <button type="submit" class="btn btn-secondary font-button-text admin-btn-compact">@(counts.ThisBrowserIsCounted ? "Don't count this browser" : "Count this browser")</button>
    </form>
</section>

<!-- What made customers look for us: the answers to "How did you hear about us?" on the enquiries
     and on the jobs, the last 30 days or all time (PROJECT_STATE.md Sections 3ej and 3et). The
     live database cannot be read from outside, so this table is where the channels are compared.
     The two columns are counted apart: an enquiry that is made a job is in both. -->
<section class="glass-card p-4 rounded-xl admin-card mb-5" id="dashboard-heard-about">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-1">
        <h3 class="font-headline-sm text-primary mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">analytics</span>
            <span>How Customers Heard About Us</span>
        </h3>
        <form method="get" asp-area="Administration" asp-controller="Dashboard" asp-action="Index" asp-fragment="dashboard-heard-about" class="m-0">
            @* The other table keeps its own choice when this one is changed. *@
            @if (counts.IsAllTime)
            {
                <input type="hidden" name="counts" value="@IndexViewModel.SiteCountsAllTime" />
            }
            <select name="heardAbout" class="admin-status-filter font-body-md" data-submit-on-change aria-label="Count the answers of">
                <option value="">Last @IndexViewModel.HeardAboutDays days</option>
                <option value="@IndexViewModel.HeardAboutAllTime" selected="@Model.HeardAboutIsAllTime">All time</option>
            </select>
        </form>
    </div>
    <p class="font-label-sm text-on-surface-variant mb-3">Every enquiry and every job @(Model.HeardAboutIsAllTime ? "so far" : "of the last " + IndexViewModel.HeardAboutDays + " days"), cancelled jobs too. An enquiry that is made a job is in both columns. The question was first asked on 12 Nov 2026: what came in before then is "Not said".</p>
    <table class="table mb-0 dashboard-heard-about-table">
        <thead>
            <tr>
                <th scope="col" class="font-label-sm text-on-surface-variant">Answer</th>
                <th scope="col" class="font-label-sm text-on-surface-variant text-end">Enquiries</th>
                <th scope="col" class="font-label-sm text-on-surface-variant text-end">Jobs</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.HeardAbout)
            {
                <tr>
                    <td class="font-body-md text-on-surface">@line.Label</td>
                    <td class="font-body-md text-primary text-end fw-bold">@line.Enquiries</td>
                    <td class="font-body-md text-primary text-end fw-bold">@line.Jobs</td>
                </tr>
            }
        </tbody>
    </table>
</section>
