@model HandyFix.Web.ViewModels.Reviews.ReviewInputModel
@{
    this.ViewData["Title"] = "Edit Review";
}

<nav class="breadcrumb-nav mb-4 admin-header-row" aria-label="breadcrumb">
    <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <a asp-area="Administration" asp-controller="Reviews" asp-action="Index">Reviews</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <span class="breadcrumb-current">@Model.CustomerName</span>
</nav>

<div class="mb-5">
    <h2 class="admin-page-title">Edit Review</h2>
    <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">The website shows the change as soon as it is saved.</p>
</div>

<div class="mx-auto admin-form-container">
    <partial name="_ReviewForm" model="Model" />
</div>
