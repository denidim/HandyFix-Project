@using HandyFix.Common
@model HandyFix.Web.ViewModels.Administration.Account.AdminAccountViewModel
@{
    this.ViewData["Title"] = "Account";
}

<div class="mb-5 admin-header-row">
    <h1 class="admin-page-title">Account</h1>
    <p class="font-label-sm text-on-surface-variant mt-1 admin-page-subtitle">The email and the password you sign in to this panel with.</p>
</div>

@if (this.TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">@this.TempData["SuccessMessage"]</div>
}

<div class="mx-auto admin-form-container d-flex flex-column gap-4">

    <!-- Login email -->
    <div class="rounded-xl shadow-sm p-5 admin-card">
        <h2 class="font-headline-sm text-primary mb-2">Login Email</h2>
        <p class="font-label-sm text-on-surface-variant mb-4">
            You sign in as <strong id="current-login-email" class="text-on-surface">@Model.LoginEmail</strong>.
            A forgotten password is reset through this address, so it has to be a mailbox you can open.
        </p>

        @* gy-4: on a phone the two boxes of a row stack, and without it the second label sat
           right under the first box. *@
        <form id="change-email-form" asp-area="Administration" asp-controller="Account" asp-action="ChangeEmail" method="post" class="d-flex flex-column gap-4">
            <div class="row gy-4">
                <div class="col-md-6 form-group">
                    <label asp-for="Email.NewEmail" class="form-label font-label-sm text-on-surface-variant mb-2"></label>
                    <input asp-for="Email.NewEmail" class="form-control py-3 admin-form-control form-pad-standard" type="email" maxlength="255" autocomplete="off" required />
                    <span asp-validation-for="Email.NewEmail" class="text-danger small"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="Email.CurrentPassword" class="form-label font-label-sm text-on-surface-variant mb-2"></label>
                    <input asp-for="Email.CurrentPassword" class="form-control py-3 admin-form-control form-pad-standard" autocomplete="current-password" required />
                    <span asp-validation-for="Email.CurrentPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="pt-4 d-flex justify-content-end form-actions-row">
                <button id="change-email-submit" class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px8" type="submit">
                    <span class="material-symbols-outlined">mail</span>
                    <span>Change Email</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Password -->
    <div class="rounded-xl shadow-sm p-5 admin-card">
        <h2 class="font-headline-sm text-primary mb-2">Password</h2>
        <p class="font-label-sm text-on-surface-variant mb-4">
            At least @GlobalConstants.PasswordMinimumLength characters. A few words in a row are easy to remember and hard to guess.
        </p>

        <form id="change-password-form" asp-area="Administration" asp-controller="Account" asp-action="ChangePassword" method="post" class="d-flex flex-column gap-4">
            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="Password.CurrentPassword" class="form-label font-label-sm text-on-surface-variant mb-2"></label>
                    <input asp-for="Password.CurrentPassword" class="form-control py-3 admin-form-control form-pad-standard" autocomplete="current-password" required />
                    <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="row gy-4">
                <div class="col-md-6 form-group">
                    <label asp-for="Password.NewPassword" class="form-label font-label-sm text-on-surface-variant mb-2"></label>
                    <input asp-for="Password.NewPassword" class="form-control py-3 admin-form-control form-pad-standard" autocomplete="new-password" required />
                    <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="Password.ConfirmPassword" class="form-label font-label-sm text-on-surface-variant mb-2"></label>
                    <input asp-for="Password.ConfirmPassword" class="form-control py-3 admin-form-control form-pad-standard" autocomplete="new-password" required />
                    <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="pt-4 d-flex justify-content-end form-actions-row">
                <button id="change-password-submit" class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px8" type="submit">
                    <span class="material-symbols-outlined">key</span>
                    <span>Change Password</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Sign out -->
    <div class="rounded-xl shadow-sm p-5 admin-card d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h2 class="font-headline-sm text-primary mb-1">Sign Out</h2>
            <p class="font-label-sm text-on-surface-variant mb-0">Do this when you finish on a computer other people use.</p>
        </div>
        <form id="sign-out-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@this.Url.Action("Index", "Home", new { area = string.Empty })" method="post">
            <button id="sign-out-submit" type="submit" class="btn btn-outline font-button-text admin-btn-outline d-flex align-items-center justify-content-center gap-2 btn-py3-px8">
                <span class="material-symbols-outlined">logout</span>
                <span>Sign Out</span>
            </button>
        </form>
    </div>
</div>
