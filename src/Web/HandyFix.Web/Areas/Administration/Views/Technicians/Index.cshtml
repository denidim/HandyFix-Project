@model IEnumerable<HandyFix.Web.ViewModels.Administration.Technicians.TechnicianAdminListViewModel>
@{
    this.ViewData["Title"] = "Manage Technicians";

    var totalTechnicians = Model.Count();
    var activeTechnicians = Model.Count(t => t.IsActive);
    var assignedJobs = Model.Sum(t => t.BookingCount);
}

<!-- Sticky Topbar Header -->
<div class="d-flex flex-col flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <div>
        <h1 class="admin-page-title">Manage Technicians</h1>
        <p class="font-label-sm text-on-surface-variant mt-1 admin-page-subtitle">The roster you assign jobs from. Add someone here before assigning them a booking.</p>
    </div>
    <a asp-area="Administration" asp-controller="Technicians" asp-action="Create" class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 w-100 w-md-auto rounded-lg btn-py3-px6">
        <span class="material-symbols-outlined">person_add</span>
        <span>Add Technician</span>
    </a>
</div>

@if (this.TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">@this.TempData["SuccessMessage"]</div>
}

@if (this.TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">@this.TempData["ErrorMessage"]</div>
}

<!-- Quick Stats -->
<div class="bento-grid bento-grid-3 mb-5">
    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">Total Technicians</p>
            <h3 class="font-headline-md mb-0 fs-headline-md font-bold text-primary">@totalTechnicians</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary dim-48 tint-secondary">
            <span class="material-symbols-outlined">engineering</span>
        </div>
    </div>

    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">Active</p>
            <h3 class="font-headline-md mb-0 fs-headline-md font-bold text-primary">@activeTechnicians</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-on-tertiary-container dim-48 tint-success">
            <span class="material-symbols-outlined">check_circle</span>
        </div>
    </div>

    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">Assigned Jobs</p>
            <h3 class="font-headline-md mb-0 fs-headline-md font-bold text-primary">@assignedJobs</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-primary dim-48 tint-surface-high">
            <span class="material-symbols-outlined">assignment_ind</span>
        </div>
    </div>
</div>

<!-- Technicians Table -->
<div class="rounded-xl overflow-hidden shadow-sm admin-card">
    <div class="px-4 py-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4 admin-table-toolbar">
        <div class="position-relative max-w-sm w-100 admin-search-wrap">
            <span class="material-symbols-outlined position-absolute text-outline admin-search-icon">search</span>
            <input class="w-100 py-2 border rounded-lg outline-none font-body-md admin-search-input" placeholder="Search technicians..." type="text" id="technicians-search">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table mb-0 text-left admin-table">
            <thead>
                <tr class="admin-table-head">
                    <th class="px-4 py-3 font-label-sm uppercase">Technician</th>
                    <th class="px-4 py-3 font-label-sm uppercase">Phone</th>
                    <th class="px-4 py-3 font-label-sm uppercase">Assigned Jobs</th>
                    <th class="px-4 py-3 font-label-sm uppercase">Status</th>
                    <th class="px-4 py-3 font-label-sm uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="technicians-table-body" class="bg-white">
                @if (Model.Any())
                {
                    @foreach (var technician in Model)
                    {
                        <tr class="align-middle admin-table-row">
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-lg d-flex align-items-center justify-content-center dim-40 tint-surface-high">
                                        <span class="material-symbols-outlined text-secondary">engineering</span>
                                    </div>
                                    <p class="font-body-md font-bold mb-0 text-primary">@technician.FullName</p>
                                </div>
                            </td>
                            <td class="px-4 py-3 font-body-md text-primary">
                                @if (!string.IsNullOrWhiteSpace(technician.PhoneNumber))
                                {
                                    <a href="tel:@technician.PhoneNumber" class="text-primary">@technician.PhoneNumber</a>
                                }
                                else
                                {
                                    <span class="text-on-surface-variant">&mdash;</span>
                                }
                            </td>
                            <td class="px-4 py-3 font-body-md text-on-surface-variant">@technician.BookingCount</td>
                            <td class="px-4 py-3">
                                @if (technician.IsActive)
                                {
                                    <span class="px-3 py-1 rounded-full font-label-sm tint-success">Active</span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full font-label-sm tint-neutral-soft">Inactive</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-area="Administration" asp-controller="Technicians" asp-action="Edit" asp-route-id="@technician.Id" class="p-2 text-on-surface-variant rounded-lg d-flex align-items-center justify-content-center dim-36 admin-btn-outline" title="Edit">
                                        <span class="material-symbols-outlined fs-20">edit</span>
                                    </a>
                                    @if (technician.BookingCount == 0)
                                    {
                                        <form asp-area="Administration" asp-controller="Technicians" asp-action="Delete" asp-route-id="@technician.Id" method="post" class="d-inline-block" onsubmit="return confirm('Delete @technician.FullName? They have no bookings, so nothing else is affected.');">
                                            <button type="submit" class="p-2 text-danger rounded-lg d-flex align-items-center justify-content-center dim-36 tint-error-soft border-error-soft" title="Delete">
                                                <span class="material-symbols-outlined fs-20">delete</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="p-2 text-outline d-flex align-items-center justify-content-center dim-36" title="Has bookings - deactivate instead of deleting">
                                            <span class="material-symbols-outlined fs-20">lock</span>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center p-4 text-muted">No technicians yet. Add one so bookings can be assigned.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Workflow reminder -->
<div class="p-4 d-flex align-items-start gap-3 help-card mt-4">
    <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary dim-40 tint-secondary help-card-icon">
        <span class="material-symbols-outlined">info</span>
    </div>
    <div>
        <h4 class="font-headline-sm text-primary mb-1 fs-15">Technicians aren't tied to availability</h4>
        <p class="font-label-sm text-on-surface-variant mb-0 fs-13 lh-snug">
            Slots in the Availability Calendar are pure capacity &mdash; they carry no technician. You pick who does the job
            on the booking itself, under <strong>Bookings &rarr; Details</strong>, once the customer has booked and paid.
            Deactivate a technician to keep them off new assignments without touching their job history.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('technicians-search');
            const rows = document.querySelectorAll('#technicians-table-body tr');

            searchInput?.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}
