@model HandyFix.Web.ViewModels.ServiceAreas.ServiceAreaAdminInputModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    this.ViewData["Title"] = $"Edit Service Area: {Model.Name}";
    this.ViewData["IsCreate"] = false;

    // Same idea as Services/Edit.cshtml checking ServiceImageExists - surface whether step 2 of
    // the workflow has actually been done, rather than leaving the admin to guess.
    var heroImagePath = $"/images/areas/{Model.Slug}-hero.webp";
    var heroImageExists = !string.IsNullOrWhiteSpace(Model.Slug)
        && System.IO.File.Exists(System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "images", "areas", $"{Model.Slug}-hero.webp"));
}

<nav class="breadcrumb-nav mb-4 admin-header-row" aria-label="breadcrumb">
    <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <a asp-area="Administration" asp-controller="ServiceAreas" asp-action="Index">Service Areas</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <span class="breadcrumb-current">Edit Area</span>
</nav>

<div class="mb-5 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div>
        <h2 class="admin-page-title">Edit Service Area: @Model.Name</h2>
        <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Update the copy, coverage details and FAQs for this area.</p>
    </div>
    <a asp-area="" asp-route="AreaDetails" asp-route-areaSlug="@Model.Slug" target="_blank" rel="noopener" class="btn btn-outline font-button-text d-flex align-items-center gap-2 admin-btn-outline btn-py3-px6">
        <span class="material-symbols-outlined fs-18">open_in_new</span>
        <span>View Public Page</span>
    </a>
</div>

<div class="mx-auto admin-form-container">
    <partial name="_ServiceAreaForm" model="Model" />

    <div class="row pt-2">
        <div class="col-md-6 mb-3">
            <div class="p-4 d-flex align-items-start gap-3 h-100 help-card">
                @if (heroImageExists)
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-on-tertiary-container dim-40 tint-success help-card-icon">
                        <span class="material-symbols-outlined">check_circle</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-primary mb-1 fs-15">Hero Image Present</h4>
                        <p class="font-label-sm text-on-surface-variant mb-0 fs-13 lh-snug">
                            Serving <code>@heroImagePath</code>. Replace the file on disk to change it.
                        </p>
                    </div>
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary dim-40 tint-secondary help-card-icon">
                        <span class="material-symbols-outlined">image_not_supported</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-primary mb-1 fs-15">Hero Image Missing</h4>
                        <p class="font-label-sm text-on-surface-variant mb-0 fs-13 lh-snug">
                            Add <code>@heroImagePath</code> at 1600&times;700. The page currently falls back to the generic hero image.
                        </p>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="p-4 d-flex align-items-start gap-3 h-100 help-card">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-primary dim-40 tint-surface-high help-card-icon">
                    <span class="material-symbols-outlined">map</span>
                </div>
                <div>
                    <h4 class="font-headline-sm text-primary mb-1 fs-15">Coverage Diagram</h4>
                    <p class="font-label-sm text-on-surface-variant mb-0 fs-13 lh-snug">
                        Positioned by the geometry entry for <code>@Model.Slug</code> in <code>_AreaCoverageMap.cshtml</code>.
                        Changing the drive time moves the point; changing the slug requires updating that key.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-service-area-form.js" asp-append-version="true"></script>
}
