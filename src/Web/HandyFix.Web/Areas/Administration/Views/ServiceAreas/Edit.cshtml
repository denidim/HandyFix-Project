@model HandyFix.Web.ViewModels.ServiceAreas.ServiceAreaAdminInputModel
@{
    this.ViewData["Title"] = $"Edit Service Area: {Model.Name}";

    // The area's place on the coverage diagram, said in words (PROJECT_STATE.md Section 3dm).
    string[] compassPoints = { "north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west" };
    var diagramStatus = Model.Slug == "chessington"
        ? $"{Model.Name} is our base, the centre of the diagram."
        : Model.DiagramBearing is double bearing
            ? $"{Model.Name} is on the diagram, {compassPoints[(int)Math.Round(bearing / 45.0) % 8]} of Chessington. Changing its postcode districts places it again, from the first one."
            : $"{Model.Name} is not on the diagram yet: we could not find where its first postcode district is. Check the districts above and save again.";
}

<nav class="breadcrumb-nav mb-4 admin-header-row" aria-label="breadcrumb">
    <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <a asp-area="Administration" asp-controller="ServiceAreas" asp-action="Index">Service Areas</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <span class="breadcrumb-current">Edit Area</span>
</nav>

<div class="mb-5 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
    <div>
        <h2 class="admin-page-title">Edit Service Area: @Model.Name</h2>
        <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Change the town's text, postcode districts, picture and questions.</p>
    </div>
    <a asp-area="" asp-route="AreaDetails" asp-route-areaSlug="@Model.Slug" target="_blank" rel="noopener" class="btn btn-outline font-button-text d-flex align-items-center gap-2 admin-btn-outline btn-py3-px6">
        <span class="material-symbols-outlined fs-18">open_in_new</span>
        <span>View Public Page</span>
    </a>
</div>

<div class="mx-auto admin-form-container">
    <partial name="_ServiceAreaForm" model="Model" />

    <div class="row pt-2">
        <div class="col-12 mb-3">
            <div class="p-4 h-100 help-card">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-primary dim-40 tint-surface-high help-card-icon">
                        <span class="material-symbols-outlined">map</span>
                    </div>
                    <div>
                        <h4 class="font-headline-sm text-primary mb-1 fs-15">Coverage Diagram</h4>
                        <p class="font-label-sm text-on-surface-variant mb-0 fs-13 lh-snug" data-diagram-status>@diagramStatus</p>
                    </div>
                </div>
                @if (Model.DiagramAreas != null)
                {
                    <partial name="_AreaCoverageMap" model="Model.DiagramAreas" />
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-faq-builder.js" asp-append-version="true"></script>
    <script src="~/js/admin-service-area-form.js" asp-append-version="true"></script>
}
