@model HandyFix.Web.ViewModels.Administration.Services.ServiceAdminInputModel
@inject HandyFix.Services.IImageStorageService ImageStorageService
@{
    this.ViewData["Title"] = $"Edit Service: {Model.Name}";
}

<!-- Breadcrumbs -->
<nav class="breadcrumb-nav mb-4 admin-header-row" aria-label="breadcrumb">
    <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <a asp-area="Administration" asp-controller="Services" asp-action="Index">Services</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <span class="breadcrumb-current">Edit Service</span>
</nav>

<!-- Page Header -->
<div class="mb-5">
    <h2 class="admin-page-title">Edit Service: @Model.Name</h2>
    <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Update details and status configuration for this service offering.</p>
</div>

<!-- Form Content -->
<div class="mx-auto admin-form-container">
    <div class="rounded-xl shadow-sm p-5 p-md-5 admin-card">
        <form asp-area="Administration" asp-controller="Services" asp-action="Edit" method="post" enctype="multipart/form-data" id="serviceForm" class="d-flex flex-column gap-5">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Slug" />

            <div class="row gy-4">
                <!-- Service Name -->
                <div class="col-md-6 form-group">
                    <label asp-for="Name" class="form-label font-label-sm text-on-surface-variant mb-2">Service Name</label>
                    <input asp-for="Name" class="form-control py-3 admin-form-control form-pad-standard" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <!-- Category -->
                <div class="col-md-6 form-group">
                    <label asp-for="CategoryId" class="form-label font-label-sm text-on-surface-variant mb-2">Category Division</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control py-3 admin-form-control form-pad-standard" required></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
            </div>

            <!-- Detailed Description -->
            <div class="form-group">
                <label asp-for="Description" class="form-label font-label-sm text-on-surface-variant mb-2">Detailed Description</label>
                <textarea asp-for="Description" class="form-control admin-form-control form-pad-standard resize-none" rows="4" required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row gy-4">
                <!-- Base Price -->
                <div class="col-md-6 form-group">
                    <label asp-for="BasePrice" class="form-label font-label-sm text-on-surface-variant mb-2">Base Price (£)</label>
                    <div class="position-relative">
                        <span class="position-absolute font-bold text-on-surface-variant admin-form-affix admin-form-affix-left">£</span>
                        <input asp-for="BasePrice" class="form-control py-3 admin-form-control form-control-price-affix" type="number" step="0.01" required />
                    </div>
                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                </div>
                <!-- Duration -->
                <div class="col-md-6 form-group">
                    <label asp-for="EstimatedDurationMinutes" class="form-label font-label-sm text-on-surface-variant mb-2">Duration (Minutes)</label>
                    <div class="position-relative">
                        <input asp-for="EstimatedDurationMinutes" class="form-control py-3 admin-form-control form-control-duration-affix" type="number" step="1" required />
                        <span class="position-absolute font-label-sm text-on-surface-variant admin-form-affix admin-form-affix-right">min</span>
                    </div>
                    <span asp-validation-for="EstimatedDurationMinutes" class="text-danger small"></span>
                </div>
            </div>

            <div class="row gy-4">
                <!-- Display Order -->
                <div class="col-md-6 form-group">
                    <label asp-for="DisplayOrder" class="form-label font-label-sm text-on-surface-variant mb-2">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control py-3 admin-form-control form-pad-standard" type="number" min="0" max="999" step="1" required />
                    <span class="font-label-sm text-on-surface-variant mt-1 d-block fs-11">Lower numbers come first in every list of services. The lowest in a category is the service the booking page opens on. Services with the same number are sorted by name.</span>
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <!-- Popular on the home page -->
                <div class="col-md-6 form-group">
                    <div class="form-check d-flex align-items-center gap-2 m-0 ps-0 form-check-beside-input">
                        <input asp-for="IsPopular" class="form-check-input checkbox-lg" type="checkbox" />
                        <label asp-for="IsPopular" class="form-check-label font-label-sm text-on-surface font-bold label-clickable">Show in Popular Services on the home page</label>
                    </div>
                    <span class="font-label-sm text-on-surface-variant mt-1 d-block fs-11">The home page shows four: the ticked services first, in list order. If fewer than four are ticked, the next services in the list fill the rest.</span>
                </div>
            </div>

            <!-- Service Image Upload -->
            <div class="form-group">
                <label asp-for="ImageFile" class="form-label font-label-sm text-on-surface-variant mb-2">Service Image</label>
                <div class="d-flex flex-column flex-md-row gap-4 align-items-md-center">
                    @if (!string.IsNullOrEmpty(Model.Slug) && ImageStorageService.ServiceImageExists(Model.Slug))
                    {
                        var imagePath = $"/images/services/{Model.Slug}-hero.webp";
                        <div class="flex-shrink-0 current-image-thumb">
                            <img src="@imagePath" asp-append-version="true" class="w-100 h-100" alt="Current image" />
                        </div>
                    }
                    <div class="flex-grow-1 w-100">
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control admin-form-control file-input-pad" />
                        <span class="font-label-sm text-on-surface-variant mt-1 d-block fs-11">Upload a new image to replace the current one. Supported formats: JPEG, PNG, WEBP. Maximum file size: 20MB.</span>
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Active Status checkbox -->
            <div class="form-group form-check d-flex align-items-center gap-2 m-0 ps-0">
                <input asp-for="IsActive" class="form-check-input checkbox-lg" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label font-label-sm text-on-surface font-bold label-clickable">Is Active Service (Visible to Public)</label>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 d-flex flex-column flex-md-row align-items-center justify-content-end gap-3 form-actions-row">
                <a asp-area="Administration" asp-controller="Services" asp-action="Index" class="btn btn-outline font-button-text admin-btn-outline btn-py3-px8">Cancel</a>
                <button class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px8" type="submit">
                    <span class="material-symbols-outlined">save</span>
                    <span>Update Service</span>
                </button>
            </div>
        </form>
    </div>
</div>
