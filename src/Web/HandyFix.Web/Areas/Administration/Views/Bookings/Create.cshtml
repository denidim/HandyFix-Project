@model HandyFix.Web.ViewModels.Booking.JobInputModel
@using HandyFix.Web.ViewModels.Booking
@{
    this.ViewData["Title"] = "Write a Job In";
}

<!-- Breadcrumbs & Header Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <nav class="breadcrumb-nav mb-0" aria-label="breadcrumb">
        <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
        <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index">Jobs</a>
        <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
        <span class="breadcrumb-current">Write a Job In</span>
    </nav>
    @if (Model.EnquiryId.HasValue)
    {
        <a asp-area="Administration" asp-controller="Enquiries" asp-action="Details" asp-route-id="@Model.EnquiryId" class="btn btn-outline d-flex align-items-center gap-2 admin-btn-compact admin-btn-outline">
            <span class="material-symbols-outlined">arrow_back</span>
            <span>Back to the Enquiry</span>
        </a>
    }
    else
    {
        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="btn btn-outline d-flex align-items-center gap-2 admin-btn-compact admin-btn-outline">
            <span class="material-symbols-outlined">arrow_back</span>
            <span>Back to List</span>
        </a>
    }
</div>

<div class="mb-5">
    <h2 class="admin-page-title">Write a Job In</h2>
    <p class="font-body-md text-on-surface-variant admin-page-subtitle">For a job that came by phone, WhatsApp, an enquiry or an agency. A first name, a phone number, a day and a time are enough.</p>
</div>

<div class="rounded-xl shadow-sm p-5 p-md-5 admin-card">
    <form asp-area="Administration" asp-controller="Bookings" asp-action="Create" method="post" class="d-flex flex-column gap-5" id="job-form">
        <input type="hidden" asp-for="EnquiryId" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <partial name="_JobCustomerFields" model="Model" />

        <div class="row gy-4">
            <div class="col-md-4 form-group">
                <label asp-for="Date" class="form-label font-label-sm text-on-surface-variant mb-2">Day</label>
                <input asp-for="Date" class="form-control py-3 admin-form-control form-pad-standard" type="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" required />
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-4 form-group">
                <label asp-for="Time" class="form-label font-label-sm text-on-surface-variant mb-2">Time</label>
                <input asp-for="Time" class="form-control py-3 admin-form-control form-pad-standard" type="time" value="@(Model.Time?.ToString(@"hh\:mm"))" required />
                <span asp-validation-for="Time" class="text-danger small"></span>
            </div>
            <div class="col-md-4 form-group">
                <label asp-for="Source" class="form-label font-label-sm text-on-surface-variant mb-2">Came From</label>
                <select asp-for="Source" class="form-control py-3 admin-form-control form-pad-standard" required>
                    @foreach (var source in JobDetailsInputModel.WrittenInSources)
                    {
                        <option value="@source" selected="@(Model.Source == source)">@source</option>
                    }
                </select>
                <span asp-validation-for="Source" class="text-danger small"></span>
            </div>
        </div>

        <p class="text-on-surface-variant mb-0 fs-13 lh-snug job-form-note">
            Writing a job in does not take its hour off sale on the website. If nobody else should be booked then, block the hour in the
            <a asp-area="Administration" asp-controller="Calendar" asp-action="Index">calendar</a>. An hour is a start time: block the next ones too if the job will run long.
        </p>

        <partial name="_JobWorkFields" model="Model" />

        <div class="pt-4 d-flex flex-column flex-md-row align-items-center justify-content-end gap-3 form-actions-row">
            <a asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="btn btn-outline font-button-text admin-btn-outline btn-py3-px8">Cancel</a>
            <button class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px8" type="submit">
                <span class="material-symbols-outlined">save</span>
                <span>Write the Job In</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
