@model HandyFix.Web.ViewModels.Booking.BookingListViewModel
@using HandyFix.Common
@{
    this.ViewData["Title"] = "Jobs";

    var bookings = Model.Bookings;
}

@functions {
    bool NextDescending(HandyFix.Web.ViewModels.Booking.BookingSortField field)
    {
        return this.Model.SortField == field ? !this.Model.Descending : false;
    }
}

<!-- Sticky Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <div>
        <h1 class="admin-page-title">Jobs</h1>
        <p class="font-label-sm text-on-surface-variant mt-1 admin-page-subtitle">Every job, booked on the website or written in by hand</p>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-3">
        <a asp-area="Administration" asp-controller="Bookings" asp-action="Create" class="btn btn-primary font-button-text admin-btn-compact d-flex align-items-center gap-2" id="write-a-job-in">
            <span class="material-symbols-outlined fs-18">add</span>
            <span>Write a job in</span>
        </a>
        <form method="get" asp-area="Administration" asp-controller="Bookings" asp-action="Index" class="m-0">
            <input type="hidden" name="sortField" value="@Model.SortField" />
            <input type="hidden" name="descending" value="@(Model.Descending.ToString())" />
            <select name="status" class="admin-status-filter font-body-md" onchange="this.form.submit()" aria-label="Show jobs that are">
                <option value="">All jobs</option>
                @foreach (var statusOption in Model.StatusOptions)
                {
                    <option value="@statusOption" selected="@(Model.StatusFilter == statusOption)">@statusOption</option>
                }
            </select>
        </form>
        <div class="position-relative max-w-sm w-100 admin-search-wrap">
            <span class="material-symbols-outlined position-absolute text-outline admin-search-icon">search</span>
            <input class="w-100 py-2 border rounded-lg outline-none font-body-md admin-search-input" placeholder="Search Ref ID or Name..." type="text" id="bookings-search">
        </div>
    </div>
</div>

@if (this.TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">@this.TempData["SuccessMessage"]</div>
}

<!-- Quick Stats -->
<div class="bento-grid bento-grid-3 mb-5">
    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">Today's Jobs</p>
            <h3 class="font-headline-md mb-0 fs-headline-md font-bold text-primary">@Model.TodaysAppointmentsCount</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary dim-48 tint-secondary">
            <span class="material-symbols-outlined">calendar_today</span>
        </div>
    </div>

    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">Waiting for a Technician</p>
            <h3 class="font-headline-md mb-0 text-secondary fs-headline-md font-bold">@Model.AwaitingTechnicianCount</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary dim-48 tint-secondary">
            <span class="material-symbols-outlined">engineering</span>
        </div>
    </div>

    <div class="glass-card p-4 rounded-xl d-flex align-items-center justify-content-between admin-stat-card">
        <div>
            <p class="font-label-sm text-on-surface-variant mb-1">This Month's Jobs, in Pounds</p>
            <h3 class="font-headline-md mb-0 fs-headline-md font-bold text-primary">£@Model.MonthlyRevenue.ToString("N2")</h3>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center text-on-tertiary-container dim-48 tint-success">
            <span class="material-symbols-outlined">payments</span>
        </div>
    </div>
</div>

<!-- Jobs List Table -->
<div class="rounded-xl overflow-hidden shadow-sm admin-card">
    <div class="px-4 py-3 d-flex align-items-center justify-content-between admin-table-toolbar">
        <h3 class="font-headline-sm text-primary mb-0">@(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "All Jobs" : Model.StatusFilter + " Jobs")</h3>
    </div>

    <div class="table-responsive">
        <table class="w-full text-left table mb-0 admin-table">
            <thead>
                <tr class="admin-table-head">
                    <th class="px-3 py-3 font-label-sm uppercase">
                        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index"
                           asp-route-sortField="CreatedOn" asp-route-descending="@this.NextDescending(HandyFix.Web.ViewModels.Booking.BookingSortField.CreatedOn)" asp-route-status="@Model.StatusFilter"
                           class="admin-sort-link @(Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.CreatedOn ? "active" : "")">
                            Ref, Came In
                            @if (Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.CreatedOn)
                            {
                                <span class="material-symbols-outlined fs-16">@(Model.Descending ? "arrow_downward" : "arrow_upward")</span>
                            }
                        </a>
                    </th>
                    <th class="px-3 py-3 font-label-sm uppercase">
                        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index"
                           asp-route-sortField="CustomerName" asp-route-descending="@this.NextDescending(HandyFix.Web.ViewModels.Booking.BookingSortField.CustomerName)" asp-route-status="@Model.StatusFilter"
                           class="admin-sort-link @(Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.CustomerName ? "active" : "")">
                            Customer
                            @if (Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.CustomerName)
                            {
                                <span class="material-symbols-outlined fs-16">@(Model.Descending ? "arrow_downward" : "arrow_upward")</span>
                            }
                        </a>
                    </th>
                    <th class="px-3 py-3 font-label-sm uppercase">
                        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index"
                           asp-route-sortField="AppointmentTime" asp-route-descending="@this.NextDescending(HandyFix.Web.ViewModels.Booking.BookingSortField.AppointmentTime)" asp-route-status="@Model.StatusFilter"
                           class="admin-sort-link @(Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.AppointmentTime ? "active" : "")">
                            Day and Time
                            @if (Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.AppointmentTime)
                            {
                                <span class="material-symbols-outlined fs-16">@(Model.Descending ? "arrow_downward" : "arrow_upward")</span>
                            }
                        </a>
                    </th>
                    <th class="px-3 py-3 font-label-sm uppercase">Technician</th>
                    <th class="px-3 py-3 font-label-sm uppercase">Price</th>
                    <th class="px-3 py-3 font-label-sm uppercase">
                        <a asp-area="Administration" asp-controller="Bookings" asp-action="Index"
                           asp-route-sortField="Status" asp-route-descending="@this.NextDescending(HandyFix.Web.ViewModels.Booking.BookingSortField.Status)" asp-route-status="@Model.StatusFilter"
                           class="admin-sort-link @(Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.Status ? "active" : "")">
                            The Job
                            @if (Model.SortField == HandyFix.Web.ViewModels.Booking.BookingSortField.Status)
                            {
                                <span class="material-symbols-outlined fs-16">@(Model.Descending ? "arrow_downward" : "arrow_upward")</span>
                            }
                        </a>
                    </th>
                    <th class="px-3 py-3 font-label-sm uppercase">The Money</th>
                    <th class="px-3 py-3 font-label-sm uppercase text-right" aria-label="Open the job"></th>
                </tr>
            </thead>
            <tbody id="bookings-table-body" class="bg-white">
                @if (bookings.Any())
                {
                    @foreach (var booking in bookings)
                    {
                        // A job that was written in may have a first name and nothing else.
                        var initials = string.Concat(booking.CustomerFirstName?.FirstOrDefault(), booking.CustomerLastName?.FirstOrDefault());

                        var jobBadgeClass = booking.JobLabel == JobLabels.Done ? "tint-success" :
                                            booking.JobLabel == JobLabels.Cancelled ? "tint-error" :
                                            booking.JobLabel == JobLabels.Abandoned ? "tint-neutral" :
                                            booking.JobLabel == JobLabels.WaitingForDeposit ? "tint-waiting" :
                                            "tint-secondary";

                        var cameIn = UkTime.FromUtc(booking.CreatedOn);

                        var moneyIn = booking.Paid > 0;
                        var paymentDotClass = moneyIn ? "payment-dot-paid" : "payment-dot-unpaid";
                        var paymentTextClass = moneyIn ? "text-on-tertiary-container" : "text-outline";

                        <tr class="align-middle admin-table-row">
                            <td class="px-3 py-3">
                                <p class="font-body-md font-bold text-secondary select-all mb-0">#@BookingReference.Short(booking.Id)</p>
                                <p class="text-on-surface-variant mb-0 fs-11 text-nowrap">@booking.Source &middot; @cameIn.ToString("dd MMM")</p>
                            </td>
                            <td class="px-3 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-on-secondary-container font-bold fs-11 avatar-badge dim-32 tint-secondary-fixed">
                                        @initials.ToUpper()
                                    </div>
                                    <div>
                                        <p class="font-body-md font-bold mb-0 text-primary">@booking.CustomerName</p>
                                        <p class="text-on-surface-variant mb-0 fs-11">@booking.Address</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-3">
                                @if (booking.HasDate)
                                {
                                    <p class="font-body-md text-primary mb-0 text-nowrap">@booking.ScheduledTime.ToString("ddd dd MMM yyyy")</p>
                                    <p class="text-on-surface-variant mb-0 fs-11">@booking.ScheduledTime.ToString("hh:mm tt")</p>
                                }
                                else
                                {
                                    <span class="text-outline text-nowrap">No date kept</span>
                                }
                            </td>
                            <td class="px-3 py-3 font-body-md text-nowrap">
                                @if (booking.TechnicianId != null)
                                {
                                    <span class="text-primary">@booking.TechnicianName</span>
                                }
                                else if (booking.CanPickTechnician)
                                {
                                    @* The rows the "Waiting for a Technician" card counts. *@
                                    <span class="font-bold text-secondary">Needs one</span>
                                }
                                else
                                {
                                    <span class="text-outline">None</span>
                                }
                            </td>
                            <td class="px-3 py-3 font-body-md font-bold text-primary text-nowrap">
                                @if (booking.Price > 0)
                                {
                                    <span>£@booking.Price.ToString("F2")</span>
                                    @if (!booking.FinalPrice.HasValue)
                                    {
                                        <p class="text-on-surface-variant mb-0 fs-11 fw-normal">estimate</p>
                                    }
                                }
                                else
                                {
                                    <span class="text-outline fw-normal">Not set</span>
                                }
                            </td>
                            <td class="px-3 py-3">
                                @* "Waiting for deposit" is the one label long enough to widen the table, so it
                                   goes onto two lines where the others stay on one. *@
                                <span class="px-3 py-1 font-label-sm font-bold @(booking.JobLabel == JobLabels.WaitingForDeposit ? "job-badge-two-lines" : "rounded-full text-nowrap") @jobBadgeClass">@booking.JobLabel</span>
                            </td>
                            <td class="px-3 py-3">
                                <span class="d-flex align-items-center gap-2 font-label-sm font-bold text-nowrap @paymentTextClass">
                                    <span class="rounded-circle payment-dot flex-shrink-0 @paymentDotClass"></span>
                                    <span>@booking.MoneyLabel</span>
                                </span>
                            </td>
                            <td class="px-3 py-3 text-right">
                                <a asp-area="Administration" asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-secondary font-button-text admin-btn-compact">Open</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center p-4 text-muted">@(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "No jobs yet." : "No jobs with this label.")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('bookings-search');
            const rows = document.querySelectorAll('#bookings-table-body tr');

            searchInput?.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(term) ? '' : 'none';
                });
            });
        });
    </script>
}
