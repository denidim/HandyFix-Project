@model HandyFix.Web.ViewModels.Booking.JobDetailsInputModel
@* What the job is and where. Shared by "Write a job in" and "Edit the details", as the customer's
   boxes are (PROJECT_STATE.md Section 3cf). *@
@{
    // A job can hold a service the list no longer offers: one deleted or switched off since.
    // It gets an option of its own, already picked. Without it the list would open on
    // "Not picked", and saving the form for any other reason would take the service off the job.
    var keepsAServiceNoLongerOffered = Model.ServiceId.HasValue && !Model.Services.Any(x => x.Id == Model.ServiceId);
}

<div class="row gy-4">
    <div class="col-md-6 form-group">
        <label asp-for="ServiceId" class="form-label font-label-sm text-on-surface-variant mb-2">Service (optional)</label>
        <select asp-for="ServiceId" class="form-control py-3 admin-form-control form-pad-standard">
            <option value="">-- Not picked --</option>
            @if (keepsAServiceNoLongerOffered)
            {
                <option value="@Model.ServiceId" selected="selected">The service it has now (no longer offered)</option>
            }
            @foreach (var category in Model.Services.GroupBy(x => x.CategoryName))
            {
                <optgroup label="@category.Key">
                    @foreach (var service in category)
                    {
                        <option value="@service.Id" selected="@(Model.ServiceId == service.Id)">@service.Name</option>
                    }
                </optgroup>
            }
        </select>
        <span class="font-label-sm text-on-surface-variant mt-1 d-block fs-11">Its price becomes the job's estimate. The final price is typed in when the job is done.</span>
        <span asp-validation-for="ServiceId" class="text-danger small"></span>
    </div>
    <div class="col-md-6 form-group">
        <label asp-for="Address" class="form-label font-label-sm text-on-surface-variant mb-2">Address (optional)</label>
        <input asp-for="Address" class="form-control py-3 admin-form-control form-pad-standard" maxlength="300" />
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="ProblemDescription" class="form-label font-label-sm text-on-surface-variant mb-2">@(Model.CameFromWebsite ? "What Is the Job (the customer's note)" : "What Is the Job (optional)")</label>
    <textarea asp-for="ProblemDescription" class="form-control admin-form-control form-pad-standard" rows="4" maxlength="3000"></textarea>
    <span asp-validation-for="ProblemDescription" class="text-danger small"></span>
</div>
