@model HandyFix.Web.ViewModels.Gallery.GalleryPhotoEditInputModel
@{
    this.ViewData["Title"] = "Edit Gallery Photo";
}

<nav class="breadcrumb-nav mb-4 admin-header-row" aria-label="breadcrumb">
    <a asp-area="Administration" asp-controller="Dashboard" asp-action="Index">Admin</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <a asp-area="Administration" asp-controller="Gallery" asp-action="Index">Gallery</a>
    <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
    <span class="breadcrumb-current">Edit Photo</span>
</nav>

<div class="mb-5">
    <h1 class="admin-page-title">Edit Gallery Photo</h1>
    <p class="font-body-md text-on-surface-variant mt-1 admin-page-subtitle">Changes appear immediately on the public Gallery page and Homepage strip.</p>
</div>

<div class="mx-auto admin-form-container">
    <div class="rounded-xl shadow-sm p-4 p-md-5 admin-card">
        <form asp-area="Administration" asp-controller="Gallery" asp-action="Edit" method="post" class="d-flex flex-column gap-4">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div>
                    <img class="gallery-admin-edit-preview" src="@Model.ImageUrl" alt="@Model.Caption" />
                </div>
            }

            <div class="form-group">
                <label asp-for="Caption" class="form-label font-label-sm text-on-surface-variant mb-2">Job Description (max 90 chars)</label>
                <input asp-for="Caption" class="form-control py-3 admin-form-control form-pad-standard" maxlength="90" required />
                <span asp-validation-for="Caption" class="text-danger small"></span>
            </div>

            <div class="row gy-4">
                <div class="col-md-4 form-group">
                    <label asp-for="StageBadge" class="form-label font-label-sm text-on-surface-variant mb-2">Stage Badge (optional)</label>
                    <select asp-for="StageBadge" class="form-control py-3 admin-form-control form-pad-standard">
                        <option value="">None</option>
                        <option value="Before">Before</option>
                        <option value="After">After</option>
                    </select>
                    <span asp-validation-for="StageBadge" class="text-danger small"></span>
                </div>

                <div class="col-md-4 form-group">
                    <label asp-for="DisplayOrder" class="form-label font-label-sm text-on-surface-variant mb-2">Display Order</label>
                    <input asp-for="DisplayOrder" class="form-control py-3 admin-form-control form-pad-standard" type="number" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="col-md-4 form-group d-flex align-items-end">
                    <div class="form-check mb-3">
                        <input asp-for="ShowOnHomePage" class="form-check-input" type="checkbox" />
                        <label asp-for="ShowOnHomePage" class="form-check-label font-body-md text-primary fw-semibold">Show on Homepage</label>
                    </div>
                </div>
            </div>

            <div class="pt-4 d-flex flex-column flex-md-row align-items-center justify-content-end gap-3 form-actions-row">
                <a asp-area="Administration" asp-controller="Gallery" asp-action="Index" class="btn btn-outline font-button-text admin-btn-outline btn-py3-px8">Cancel</a>
                <button class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px8" type="submit">
                    <span class="material-symbols-outlined">save</span>
                    <span>Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>
