@using HandyFix.Services.Data.Gallery
@model HandyFix.Web.ViewModels.Gallery.GalleryAdminIndexViewModel
@{
    this.ViewData["Title"] = "Manage Gallery";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-5 gap-4 admin-header-row">
    <div>
        <div class="d-flex align-items-center gap-3">
            <h1 class="admin-page-title">Gallery</h1>
            <span class="px-3 py-1 font-bold font-label-sm rounded-full tint-secondary border-secondary-soft">
                @Model.HomePageCount / 6+ On Home
            </span>
        </div>
        <p class="font-label-sm text-on-surface-variant mt-1 admin-page-subtitle">Upload completed job photos in batches, star at least 6 for the homepage strip, and reorder or edit captions below.</p>
    </div>
    <a asp-area="" asp-controller="Gallery" asp-action="Index" target="_blank" rel="noopener" class="btn btn-outline admin-btn-outline font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px6">
        <span class="material-symbols-outlined">open_in_new</span>
        <span>View Public Gallery</span>
    </a>
</div>

@if (this.TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">@this.TempData["SuccessMessage"]</div>
}

<!-- Summary Stats -->
<div class="bento-grid bento-grid-3 mb-5">
    <div class="glass-card p-4 rounded-xl admin-stat-card">
        <p class="font-label-sm text-on-surface-variant mb-1 uppercase tracking-wider">Total Photos</p>
        <p class="font-headline-lg mb-0 fs-headline-lg font-bold text-primary">@Model.TotalCount</p>
    </div>

    <div class="glass-card p-4 rounded-xl admin-stat-card">
        <p class="font-label-sm text-on-surface-variant mb-1 uppercase tracking-wider">Starred for Homepage</p>
        <p class="font-headline-lg mb-0 fs-headline-lg font-bold text-secondary">@Model.HomePageCount</p>
    </div>

    <div class="glass-card p-4 rounded-xl admin-stat-card">
        <p class="font-label-sm text-on-surface-variant mb-1 uppercase tracking-wider">Homepage Strip Status</p>
        <p class="font-body-md font-bold mb-0 @(Model.HomePageCount >= 6 ? "text-success" : "text-muted")">
            @(Model.HomePageCount >= 6 ? "Active on Home Page" : $"Hidden (star {6 - Model.HomePageCount} more)")
        </p>
    </div>
</div>

<!-- Batch Upload Card -->
<div class="rounded-xl shadow-sm p-4 p-md-5 mb-5 admin-card">
    <h2 class="font-headline-sm text-primary mb-1">Upload Job Photos</h2>
    <p class="font-label-sm text-on-surface-variant mb-4">Select up to 20 photos from one job or type of work. Descriptions stay capped at 90 characters so every Polaroid card lines up cleanly.</p>

    <form asp-area="Administration" asp-controller="Gallery" asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Upload.Photos" class="form-label font-label-sm text-on-surface-variant mb-2">Photos</label>
            <div class="upload-dropzone" data-click-target="#gallery-upload-input">
                <span class="material-symbols-outlined upload-icon" aria-hidden="true">add_a_photo</span>
                <p class="upload-text">Drag and drop images here or click to browse</p>
                <span class="upload-hint">Supports JPG, PNG, WEBP (Max 15MB each, up to 20 photos at once). EXIF metadata stripped automatically.</span>
                <input asp-for="Upload.Photos"
                       id="gallery-upload-input"
                       class="d-none"
                       type="file"
                       multiple
                       accept="image/jpeg,image/png,image/webp"
                       data-max-files="@GalleryService.MaxBatchUploadCount"
                       data-max-size-mb="@(GalleryService.MaxFileSizeBytes / (1024 * 1024))"
                       data-max-total-mb="@(GalleryService.MaxBatchBytes / (1024 * 1024))"
                       data-preview-grid="#gallery-upload-previews" />
            </div>
            <div id="gallery-upload-previews" class="image-preview-grid mt-3"></div>
            <span asp-validation-for="Upload.Photos" class="text-danger small"></span>
        </div>

        <div class="row gy-4">
            <div class="col-md-6 form-group">
                <label asp-for="Upload.Caption" class="form-label font-label-sm text-on-surface-variant mb-2">Job Description (max 90 chars)</label>
                <input asp-for="Upload.Caption" class="form-control py-3 admin-form-control form-pad-standard" maxlength="90" placeholder="Combi boiler pressure gauge and PRV replacement in Surrey" required />
                <span asp-validation-for="Upload.Caption" class="text-danger small"></span>
            </div>

            <div class="col-md-3 form-group">
                <label asp-for="Upload.StageBadge" class="form-label font-label-sm text-on-surface-variant mb-2">Stage Badge (optional)</label>
                <select asp-for="Upload.StageBadge" class="form-control py-3 admin-form-control form-pad-standard">
                    <option value="">None</option>
                    <option value="Before">Before</option>
                    <option value="After">After</option>
                </select>
                <span asp-validation-for="Upload.StageBadge" class="text-danger small"></span>
            </div>

            <div class="col-md-3 form-group d-flex align-items-end">
                <div class="form-check mb-3">
                    <input asp-for="Upload.ShowOnHomePage" class="form-check-input" type="checkbox" />
                    <label asp-for="Upload.ShowOnHomePage" class="form-check-label font-body-md text-primary fw-semibold">Show on Homepage</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary font-button-text d-flex align-items-center justify-content-center gap-2 rounded-lg btn-py3-px6">
                <span class="material-symbols-outlined">add_a_photo</span>
                <span>Upload Selected Photos</span>
            </button>
        </div>
    </form>
</div>

<!-- Existing Photos Table -->
<div class="rounded-xl overflow-hidden shadow-sm admin-card">
    <div class="table-responsive">
        <table class="table mb-0 text-left admin-table">
            <thead>
                <tr class="admin-table-head">
                    <th class="px-4 py-3 font-label-sm uppercase">Photo</th>
                    <th class="px-4 py-3 font-label-sm uppercase">Description</th>
                    <th class="px-4 py-3 font-label-sm uppercase">Badge</th>
                    <th class="px-4 py-3 font-label-sm uppercase text-center">Home Strip</th>
                    <th class="px-4 py-3 font-label-sm uppercase text-center">Order</th>
                    <th class="px-4 py-3 font-label-sm uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (Model.Photos.Any())
                {
                    @for (int i = 0; i < Model.Photos.Count; i++)
                    {
                        var photo = Model.Photos[i];
                        var starIcon = photo.ShowOnHomePage ? "star" : "star_outline";
                        <tr class="align-middle admin-table-row">
                            <td class="px-4 py-3">
                                <a href="@photo.ImageUrl" target="_blank" rel="noopener" title="Open full resolution photo">
                                    <img class="gallery-admin-thumb" src="@(photo.CardImageUrl ?? photo.ImageUrl)" alt="@photo.Caption" loading="lazy" />
                                </a>
                            </td>
                            <td class="px-4 py-3">
                                <p class="font-body-md font-bold text-primary mb-1">@photo.Caption</p>
                                <span class="font-label-sm text-on-surface-variant fs-11">Added @photo.CreatedOn.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrWhiteSpace(photo.StageBadge))
                                {
                                    <span class="px-3 py-1 rounded-full font-label-sm @(photo.StageBadge == "After" ? "tint-success" : "tint-neutral")">@photo.StageBadge</span>
                                }
                                else
                                {
                                    <span class="text-on-surface-variant font-label-sm">None</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <form asp-area="Administration" asp-controller="Gallery" asp-action="ToggleHome" asp-route-id="@photo.Id" method="post" class="d-inline-block">
                                    <button type="submit"
                                            class="p-2 rounded-lg d-inline-flex align-items-center justify-content-center dim-36 @(photo.ShowOnHomePage ? "tint-secondary border-secondary-soft text-secondary" : "admin-btn-outline text-on-surface-variant")"
                                            title="@(photo.ShowOnHomePage ? "Remove from homepage strip" : "Feature on homepage strip")">
                                        <span class="material-symbols-outlined fs-20">@starIcon</span>
                                    </button>
                                </form>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="d-inline-flex gap-1">
                                    <form asp-area="Administration" asp-controller="Gallery" asp-action="Move" asp-route-id="@photo.Id" asp-route-direction="-1" method="post" class="d-inline-block">
                                        <button type="submit" class="p-1 text-on-surface-variant rounded-lg d-flex align-items-center justify-content-center dim-32 admin-btn-outline" title="Move up" disabled="@(i == 0)">
                                            <span class="material-symbols-outlined fs-18">arrow_upward</span>
                                        </button>
                                    </form>
                                    <form asp-area="Administration" asp-controller="Gallery" asp-action="Move" asp-route-id="@photo.Id" asp-route-direction="1" method="post" class="d-inline-block">
                                        <button type="submit" class="p-1 text-on-surface-variant rounded-lg d-flex align-items-center justify-content-center dim-32 admin-btn-outline" title="Move down" disabled="@(i == Model.Photos.Count - 1)">
                                            <span class="material-symbols-outlined fs-18">arrow_downward</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-area="Administration" asp-controller="Gallery" asp-action="Edit" asp-route-id="@photo.Id" class="p-2 text-on-surface-variant rounded-lg d-flex align-items-center justify-content-center dim-36 admin-btn-outline" title="Edit photo details">
                                        <span class="material-symbols-outlined fs-20">edit</span>
                                    </a>
                                    <form asp-area="Administration" asp-controller="Gallery" asp-action="Delete" asp-route-id="@photo.Id" method="post" class="d-inline-block" data-confirm="Permanently delete this photo from the gallery and photo storage?">
                                        <button type="submit" class="p-2 text-danger rounded-lg d-flex align-items-center justify-content-center dim-36 tint-error-soft border-error-soft" title="Delete photo">
                                            <span class="material-symbols-outlined fs-20">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center p-4 text-muted">No gallery photos uploaded yet. Use the upload form above to add job photos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/image-upload.js" asp-append-version="true"></script>
}
