@page
@using HandyFix.Web.Services.Accounts
@using HandyFix.Web.Services.Forms
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="brand-logo"><a class="site-logo" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_Logo" model="@("auth")" /></a></h1>
            @if (Model.Sent)
            {
                <p class="subtitle">Check your inbox.</p>
            }
            else
            {
                <p class="subtitle">Enter the email you sign in with. We will send you a link to choose a new password.</p>
            }
        </div>

        @if (Model.Sent)
        {
            <p id="reset-link-sent" class="auth-notice" role="status">
                If that address is the admin login, an email with a link is on its way. The link works for @AdminAccountService.ResetLinkHours hours.
            </p>
            <p class="subtitle">Nothing after a few minutes? Look in the spam folder, then ask again.</p>
        }
        else
        {
            <form id="forgot-password-form" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-field">
                    <label class="form-label" asp-for="Input.Email">Email Address</label>
                    <div class="input-with-icon">
                        <span class="field-icon material-symbols-outlined">mail</span>
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Input.Email" class="validation-error"></span>
                </div>

                <partial name="_FormGuard" model="@FormNames.ForgotPassword" />

                <div>
                    <button id="forgot-password-submit" type="submit" class="btn btn-primary btn-block">
                        <span>Send the link</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        }

        <div class="auth-footer">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
