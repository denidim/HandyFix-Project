@page
@using HandyFix.Common
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="auth-page-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="brand-logo"><a class="site-logo" asp-area="" asp-controller="Home" asp-action="Index"><partial name="_Logo" model="@("auth")" /></a></h1>
            @if (!Model.LinkRefused)
            {
                <p class="subtitle">Choose a new password, at least @GlobalConstants.PasswordMinimumLength characters long. A few words in a row work well.</p>
            }
        </div>

        @if (Model.LinkRefused)
        {
            <p id="reset-link-refused" class="validation-summary" role="alert">
                This link no longer works. It is older than its time limit, or it has been used already.
            </p>
            <div>
                <a id="reset-new-link" asp-page="./ForgotPassword" class="btn btn-primary btn-block">
                    <span>Send me a new link</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        }
        else
        {
            <form id="reset-password-form" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <input type="hidden" asp-for="Input.UserId" />
                <input type="hidden" asp-for="Input.Code" />

                <div class="form-field">
                    <label class="form-label" asp-for="Input.NewPassword">New Password</label>
                    <div class="input-with-icon">
                        <span class="field-icon material-symbols-outlined">lock</span>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="validation-error"></span>
                </div>

                <div class="form-field">
                    <label class="form-label" asp-for="Input.ConfirmPassword">New Password Again</label>
                    <div class="input-with-icon">
                        <span class="field-icon material-symbols-outlined">lock</span>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
                </div>

                <div>
                    <button id="reset-password-submit" type="submit" class="btn btn-primary btn-block">
                        <span>Change password</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        }

        <div class="auth-footer">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
