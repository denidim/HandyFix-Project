# Copy to `.env` beside docker-compose.prod.yml on the PRODUCTION server and
# fill in real values. The filled-in file is never committed. Real values
# live in docs/private/INFRASTRUCTURE.md.
#
# Every line has to be filled in before the first deploy. The compose file
# refuses to start without most of them, and says which one is missing.
#
# A dollar sign in a value has to be written twice (`$$`): docker compose
# reads a single `$` in this file as the start of another setting's name.

# SQL Server connection string, pointed at the DB host's PRIVATE ip
# (database traffic never touches the public internet). The live site has
# a login of its own, with rights in handyfix_prod and nowhere else.
DB_CONNECTION_STRING=Server=<DB_PRIVATE_IP>,1433;Database=handyfix_prod;User Id=handyfix_prod_app;Password=<...>;TrustServerCertificate=True;MultipleActiveResultSets=true

# The admin account's login email and password. Both are read at ONE start
# only: the first start of the database, which makes the account. Choose
# them before that start. The email must be a mailbox the owner can open (a
# forgotten password is reset through it); the password needs at least 10
# characters. Afterwards both are changed in the admin panel, on the Account
# page, and these two lines can be deleted. See docs/WORKFLOW_ADMIN_ACCOUNT.md.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Brevo transactional email API key: one made for the live site, not
# staging's, so either can be cancelled without touching the other.
BREVO_API_KEY=

# Cloudflare Turnstile widget keys (Cloudflare dashboard -> Turnstile -> the
# widget -> Settings). The widget's hostname list must hold the real domain,
# or the forms show an error where the check should be. Both keys belong to
# one widget and only work as a pair.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe, LIVE. A restricted key made outside any sandbox (it starts
# rk_live_), with one permission: Checkout Sessions, Write. The webhook
# secret (whsec_...) belongs to a webhook made in the same place: payload
# "Snapshot", events checkout.session.completed and
# checkout.session.expired, pointed at
# https://plumbing-handyman-surrey.co.uk/api/payment/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 bucket for customers' photos: the live site's own bucket and
# its own key, not the bucket development and staging share.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SERVICE_URL=
R2_PUBLIC_URL=
R2_BUCKET_NAME=

# BEFORE LAUNCH ONLY. Until the site is opened, every page asks for this name
# and password (the Stripe webhook's address is the one exception). Make the
# hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# and write every $ in it twice ($$): docker compose reads a single $ in
# this file as the start of another setting's name. Both lines are deleted
# when the site launches, with the block in the Caddyfile that reads them.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Not set here, on purpose:
#   IMAGE_TAG  only to go back a version, and then on the command line:
#              IMAGE_TAG=<commit id> docker compose -f docker-compose.prod.yml up -d
#   the email addresses and the subject mark: the live site uses the code's
#              own (bookings@ as the sender, info@ for notices, no mark)
