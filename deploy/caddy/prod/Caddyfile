{
	servers {
		# The live site sits behind Cloudflare's proxy, so every request reaches
		# this server from one of Cloudflare's own addresses, with the visitor's
		# address in a header. Caddy believes that header only when the request
		# really comes from Cloudflare: these are its published ranges
		# (https://www.cloudflare.com/ips/, read 2026-10-09). A request that
		# reaches this server any other way is taken to come from the address
		# it came from, whatever its headers say.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

		# The header Cloudflare writes the visitor's address into. It replaces
		# whatever the visitor sent under that name, which X-Forwarded-For does
		# not: a visitor can put a made-up address at the front of that one.
		client_ip_headers CF-Connecting-IP
	}
}

(origin_certificate) {
	# Cloudflare's own certificate for the hop between Cloudflare and this
	# server (its "Origin Certificate", with the SSL mode "Full (strict)").
	# Caddy's usual free certificate needs the certificate authority to reach
	# this server directly, and Cloudflare stands in between. Only Cloudflare
	# trusts this one, so the proxy has to stay switched on. The two files are
	# on the server only, never in the repository.
	tls /certs/origin.pem /certs/origin.key
}

www.plumbing-handyman-surrey.co.uk {
	import origin_certificate

	# One address for the site: the name without "www".
	redir https://plumbing-handyman-surrey.co.uk{uri} permanent
}

plumbing-handyman-surrey.co.uk {
	import origin_certificate

	# BEFORE LAUNCH ONLY. The domain points here, but the site is not open
	# yet: every page asks for a password, so the checks on the real address
	# can be made without a visitor or a search engine walking in. Launching
	# the site is deleting this block, the two BASIC_AUTH lines in the compose
	# file and the same two in the server's .env.
	#
	# Stripe calls one address by itself to say a deposit was paid, and has no
	# way to answer a password prompt, so that path is left outside. It is not
	# open for that: the app refuses any call that does not carry Stripe's
	# signature.
	#
	# The logo the site's emails show is left outside too. An email program
	# fetches it from here whoever sent the email, staging included, and it
	# cannot answer a password prompt either. It is a picture of the logo.
	@behindThePassword not path /api/payment/webhook /images/email/*
	basic_auth @behindThePassword {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy web:8080 {
		# One address goes to the app: the visitor's, as worked out above.
		# Left alone, Caddy adds Cloudflare's address behind the visitor's,
		# the app reads the last one, and every visitor shares the form limit
		# of a handful of Cloudflare servers.
		header_up X-Forwarded-For {client_ip}

		# A deploy replaces the app's container, and for some seconds nothing
		# answers. A request that arrives then waits for the new container
		# and is not turned away with an error. Only a request that could not
		# be handed over is tried again, so nothing is ever sent twice.
		lb_try_duration 30s
	}
}
