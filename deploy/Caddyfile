{$STAGING_HOSTNAME} {
	# Stripe calls this one address by itself to say a deposit was paid, and has
	# no way to answer a password prompt, so it is the only path left outside
	# Basic Auth. It is not open for that: the app refuses any call that does not
	# carry Stripe's signature.
	@behindThePassword not path /api/payment/webhook
	basic_auth @behindThePassword {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Belt and braces alongside Basic Auth: if auth is ever misconfigured or
	# dropped, this stops a search engine indexing staging, a copy of the real
	# site under another address.
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy web:8080
}
