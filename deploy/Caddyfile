{$STAGING_HOSTNAME} {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Belt and braces alongside Basic Auth: if auth is ever misconfigured or
	# dropped, this stops a search engine indexing staging, a copy of the real
	# site under another address.
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy web:8080
}
