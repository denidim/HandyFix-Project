# Copy to `.env` in this same directory on the staging server and fill in
# real values. `.env` is gitignored -- never commit it. Real values live in
# docs/private/INFRASTRUCTURE.md.

IMAGE_TAG=latest

# SQL Server connection string, pointed at the DB host's PRIVATE ip
# (see PROJECT_STATE.md Section 1 -- database traffic never touches the
# public internet). Use a dedicated least-privilege login, not sa.
DB_CONNECTION_STRING=Server=<DB_PRIVATE_IP>,1433;Database=handyfix_staging;User Id=handyfix_staging_app;Password=<...>;TrustServerCertificate=True;MultipleActiveResultSets=true

# Real staging admin password -- must NOT be the Admin123! dev fallback.
ADMIN_SEED_PASSWORD=

# Brevo transactional email API key.
BREVO_API_KEY=

# Must be addresses verified as senders in the Brevo account -- Brevo
# rejects sends from anything unverified. Left empty, both default to
# bookings@ on the real domain.
EMAIL_BOOKINGS_FROM_ADDRESS=
EMAIL_SYSTEM_FROM_ADDRESS=

# Where notices to the company go: paid deposits, enquiries and job
# applications. Left empty, it is info@ on the real domain. Set it to your
# own address on staging, so test enquiries do not reach the company inbox.
ADMIN_NOTIFICATION_EMAIL=

# Hetzner reverse-DNS hostname for the staging host's public IP.
STAGING_HOSTNAME=

# HTTP Basic Auth guarding the whole staging site from crawlers/randoms.
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Cloudflare R2 bucket credentials for photo uploads.
# Note: Staging reuses the dev bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SERVICE_URL=
R2_PUBLIC_URL=
R2_BUCKET_NAME=
