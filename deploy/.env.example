# Copy to `.env` in this same directory on the staging server and fill in
# real values. `.env` is gitignored -- never commit it. Real values live in
# docs/private/INFRASTRUCTURE.md.

IMAGE_TAG=latest

# SQL Server connection string, pointed at the DB host's PRIVATE ip
# (see PROJECT_STATE.md Section 1 -- database traffic never touches the
# public internet). Use a dedicated least-privilege login, not sa.
DB_CONNECTION_STRING=Server=<DB_PRIVATE_IP>,1433;Database=handyfix_staging;User Id=handyfix_staging_app;Password=<...>;TrustServerCertificate=True;MultipleActiveResultSets=true

# Real staging admin password -- must NOT be the Admin123! dev fallback.
ADMIN_SEED_PASSWORD=

# Brevo transactional email API key.
BREVO_API_KEY=

# Must be addresses verified as senders in the Brevo account -- Brevo
# rejects sends from anything unverified. Left empty, both default to
# bookings@ on the real domain. Leave them empty on staging too: the real
# sender is then tried there before the live site depends on it.
EMAIL_BOOKINGS_FROM_ADDRESS=
EMAIL_SYSTEM_FROM_ADDRESS=

# A mark put in front of every subject. [STAGING] on staging, because its
# emails come from the same address as the live site's. Empty on the live
# site, which means no mark.
EMAIL_SUBJECT_PREFIX=

# Where notices to the company go: paid deposits, enquiries and job
# applications. Left empty, it is info@ on the real domain. On staging set
# a role address on the domain that forwards to whoever tests it, so test
# enquiries stay out of the company inbox and no person's own address is
# in a server setting. See docs/WORKFLOW_EMAIL.md.
ADMIN_NOTIFICATION_EMAIL=

# Cloudflare Turnstile widget keys, from the Cloudflare dashboard (Turnstile
# -> the widget -> Settings). The widget must list this site's hostname. The
# site key is public (it is in every form's HTML); the secret key is not.
# The public forms fail without both, on purpose. Until a real widget
# exists, Cloudflare's published test keys make every check pass:
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hetzner reverse-DNS hostname for the staging host's public IP.
STAGING_HOSTNAME=

# HTTP Basic Auth guarding the whole staging site from crawlers/randoms.
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Cloudflare R2 bucket credentials for photo uploads.
# Note: Staging reuses the dev bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SERVICE_URL=
R2_PUBLIC_URL=
R2_BUCKET_NAME=
